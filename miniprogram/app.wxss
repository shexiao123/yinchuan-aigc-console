/* 宁夏云辇文化科技有限公司 - 全局样式
   调性：温暖生活服务风。暖陶土色主色 + 米白底 + 圆角柔阴影 */

page {
  --brand: #C4703F;
  --brand-deep: #A85A2D;
  --brand-soft: #F6E7DA;
  --ink: #2C2622;
  --ink-2: #6B6058;
  --ink-3: #9A8E85;
  --line: #EDE4DA;
  --bg: #FBF7F2;
  --card: #FFFFFF;
  --olive: #6E7F5C;
  --rose: #B5707A;
  --shadow: 0 2rpx 16rpx rgba(120, 90, 60, 0.07);
  --shadow-lg: 0 8rpx 32rpx rgba(120, 90, 60, 0.12);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, button, input, textarea, scroll-view, swiper, image {
  box-sizing: border-box;
}

/* ---------------- 布局 ---------------- */

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-with-tabbar {
  padding-bottom: 140rpx;
}

.container {
  padding: 0 28rpx;
}

.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink);
}

.section-title-sm {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.section-sub {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-left: 14rpx;
}

.section-more {
  font-size: 25rpx;
  color: var(--ink-3);
}

/* ---------------- 卡片 ---------------- */

.card {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.card-pad {
  padding: 28rpx;
}

.card + .card {
  margin-top: 24rpx;
}

/* ---------------- 按钮 ---------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
  padding: 0 32rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.btn-primary:active {
  background: var(--brand-deep);
}

.btn-ghost {
  background: transparent;
  color: var(--brand);
  border: 2rpx solid var(--brand-soft);
}

.btn-soft {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.btn-danger {
  background: #C0574A;
  color: #fff;
}

.btn-sm {
  height: 60rpx;
  font-size: 25rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.45;
}

/* ---------------- 标签 ---------------- */

.tag {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-plain {
  background: #F3EDE6;
  color: var(--ink-2);
}

.tag-olive {
  background: #EBF0E6;
  color: var(--olive);
}

.tag-rose {
  background: #F7E9EB;
  color: var(--rose);
}

/* ---------------- 状态徽标 ---------------- */

.badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  font-size: 23rpx;
  font-weight: 500;
}

.badge-pending { background: #FBF0DC; color: #A9752B; }
.badge-taken { background: #E7EFF6; color: #4A6E8C; }
.badge-busy { background: #EDE7F5; color: #6B5B92; }
.badge-delivered { background: #F5E9E4; color: var(--brand-deep); }
.badge-done { background: #E6F0E6; color: #4F7A4F; }
.badge-cancelled { background: #EFEBE6; color: var(--ink-3); }

/* ---------------- 价格 ---------------- */

.price {
  color: var(--brand);
  font-weight: 600;
}

.price-symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.price-value {
  font-size: 38rpx;
}

.price-old {
  color: var(--ink-3);
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}

.price-unit {
  color: var(--ink-3);
  font-size: 24rpx;
  margin-left: 6rpx;
}

/* ---------------- 文本 ---------------- */

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.subtitle {
  font-size: 25rpx;
  color: var(--ink-2);
}

.muted {
  color: var(--ink-3);
  font-size: 24rpx;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---------------- 表单 ---------------- */

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 14rpx;
}

.input,
.textarea {
  width: 100%;
  background: #FAF6F1;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.textarea {
  height: 180rpx;
  line-height: 1.6;
}

.input-placeholder {
  color: #BFB4AA;
}

/* ---------------- 分割与空态 ---------------- */

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

.empty {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  opacity: 0.5;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 27rpx;
  color: var(--ink-3);
}

.empty-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #B5AAA0;
}

/* ---------------- 头像 ---------------- */

.avatar {
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  flex-shrink: 0;
}

.avatar-lg { width: 112rpx; height: 112rpx; font-size: 42rpx; }
.avatar-md { width: 76rpx; height: 76rpx; font-size: 30rpx; }
.avatar-sm { width: 56rpx; height: 56rpx; font-size: 24rpx; }

/* ---------------- 加载 ---------------- */

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
}

/* ---------------- 悬浮底部操作条 ---------------- */

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  z-index: 20;
  backdrop-filter: blur(10rpx);
}

.action-bar-spacer {
  height: 140rpx;
}
