/* 智能工作台 · 暖铜纸感，与 app.wxss 全局令牌统一 */
.smart-page { padding-bottom: 48rpx; }

.smart-hero {
  margin: 20rpx; padding: 34rpx 30rpx;
  background: #3A2A1C; border-radius: 20rpx;
  display: flex; flex-direction: column;
}
.smart-hero-eyebrow { color: #E8C89A; font-size: 20rpx; letter-spacing: 3rpx; font-weight: 600; margin-bottom: 16rpx; }
.smart-hero-title { color: #FFF8EC; font-size: 42rpx; font-weight: 700; line-height: 1.3; margin-bottom: 12rpx; }
.smart-hero-sub { color: #E6D9C8; font-size: 24rpx; line-height: 1.65; margin-bottom: 26rpx; }
.smart-tabs { display: flex; }
.smart-tab {
  padding: 12rpx 32rpx; margin-right: 14rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(255, 248, 236, .45); color: #FFF8EC; font-size: 25rpx;
}
.smart-tab.on { background: #FFF8EC; color: #7A411C; border-color: #FFF8EC; }

.smart-demo-hint {
  margin: 0 20rpx 18rpx; padding: 14rpx 18rpx;
  background: #FBEFE4; border: 1rpx solid var(--line); border-radius: 12rpx;
  color: #9A5326; font-size: 22rpx; line-height: 1.55;
}

.smart-form {
  margin: 0 20rpx; padding: 22rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 16rpx;
}
.smart-field { margin-bottom: 18rpx; }
.smart-label { display: block; color: var(--ink-2); font-size: 23rpx; margin-bottom: 8rpx; }
.smart-picker, .smart-input {
  height: 72rpx; line-height: 72rpx; padding: 0 18rpx;
  background: #FFFDF9; border: 1rpx solid var(--line); border-radius: 10rpx;
  color: var(--ink); font-size: 26rpx;
}
.smart-input { height: 72rpx; }
.smart-caret { float: right; color: #B5793D; font-size: 32rpx; }
.smart-switch-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8rpx 0 18rpx; color: var(--ink-2); font-size: 24rpx;
}
.smart-run {
  background: #A85A2D; color: #FFF8EC; font-size: 27rpx; font-weight: 600;
  border-radius: 12rpx; height: 80rpx; line-height: 80rpx;
}
.smart-run::after { border: none; }

.smart-weights { display: flex; flex-wrap: wrap; align-items: center; margin: 22rpx 20rpx 8rpx; }
.smart-weights-label { color: var(--ink-3); font-size: 21rpx; margin-right: 10rpx; }
.smart-weight {
  padding: 5rpx 14rpx; margin: 0 8rpx 8rpx 0; border-radius: 999rpx;
  background: #F5EADB; border: 1rpx solid var(--line);
  color: var(--ink-2); font-size: 20rpx;
}
.smart-weights-note { color: var(--ink-3); font-size: 20rpx; }

.smart-result-head { display: flex; flex-direction: column; margin: 24rpx 20rpx 14rpx; }
.smart-result-title { color: var(--ink); font-size: 32rpx; font-weight: 700; }
.smart-result-sub { color: var(--ink-3); font-size: 21rpx; margin-top: 6rpx; }

.smart-card {
  margin: 0 20rpx 20rpx; padding: 24rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 16rpx;
  box-shadow: var(--shadow);
}
.smart-card-top { display: flex; align-items: flex-start; }
.smart-score-ring {
  flex: 0 0 116rpx; width: 116rpx; height: 116rpx; border-radius: 50%;
  background: #EFE0C8; border: 10rpx solid #A85A2D;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  margin-right: 20rpx;
}
.smart-score-num { color: #A85A2D; font-size: 38rpx; font-weight: 700; line-height: 1.1; }
.smart-score-label { color: var(--ink-3); font-size: 18rpx; }
.smart-card-head { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.smart-rank { color: #B5793D; font-size: 18rpx; letter-spacing: 2rpx; }
.smart-card-title { color: var(--ink); font-size: 28rpx; font-weight: 650; line-height: 1.4; margin: 4rpx 0 6rpx; }
.smart-card-meta { color: var(--ink-3); font-size: 20rpx; line-height: 1.5; }
.smart-card-price { color: #A85A2D; font-size: 30rpx; font-weight: 700; margin-top: 10rpx; }
.smart-card-cta {
  flex: 0 0 auto; padding: 8rpx 18rpx; border-radius: 999rpx;
  background: #A85A2D; color: #FFF8EC; font-size: 21rpx;
}

.smart-bars { margin: 22rpx 0 16rpx; }
.smart-bar { display: flex; align-items: center; margin-bottom: 8rpx; }
.smart-bar-label { flex: 0 0 130rpx; color: var(--ink-2); font-size: 20rpx; }
.smart-bar-track { flex: 1; height: 10rpx; background: #F3E9D9; border-radius: 99rpx; overflow: hidden; }
.smart-bar-fill { height: 100%; background: #A85A2D; border-radius: 99rpx; }
.smart-bar-val { flex: 0 0 80rpx; text-align: right; color: var(--ink-3); font-size: 19rpx; }

.smart-reasons, .smart-cautions { display: flex; flex-wrap: wrap; }
.smart-reason, .smart-caution {
  padding: 6rpx 12rpx; margin: 0 8rpx 8rpx 0; border-radius: 8rpx; font-size: 20rpx;
}
.smart-reason { background: #F5EADB; color: var(--ink-2); }
.smart-caution { background: #FBEFE4; color: #9A5326; }
.smart-empty { padding: 60rpx 20rpx; text-align: center; color: var(--ink-3); font-size: 24rpx; }

.smart-quote-main {
  margin: 0 20rpx 20rpx; padding: 30rpx;
  background: #F7ECDA; border: 1rpx solid var(--line); border-radius: 16rpx;
  display: flex; flex-direction: column;
}
.smart-quote-caption { color: var(--ink-3); font-size: 22rpx; }
.smart-quote-num { color: #A85A2D; font-size: 44rpx; font-weight: 700; margin: 14rpx 0 10rpx; }
.smart-quote-dash { color: #B3A191; font-weight: 400; }
.smart-quote-sub { color: var(--ink-2); font-size: 22rpx; line-height: 1.6; margin-bottom: 24rpx; }
.smart-quote-cta {
  align-self: flex-start; background: #A85A2D; color: #FFF8EC;
  font-size: 24rpx; border-radius: 10rpx; padding: 0 26rpx; height: 70rpx; line-height: 70rpx;
}
.smart-quote-cta::after { border: none; }

.smart-quote-breakdown {
  margin: 0 20rpx; padding: 24rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 16rpx;
}
.smart-quote-breakdown-title { color: var(--ink); font-size: 26rpx; font-weight: 650; margin-bottom: 12rpx; }
.smart-quote-row {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 14rpx 0; border-bottom: 1rpx dashed #F0E4D2;
}
.smart-quote-row:last-child { border-bottom: none; }
.smart-quote-label { color: var(--ink-2); font-size: 23rpx; }
.smart-quote-note { color: var(--ink-3); font-size: 19rpx; margin-left: 10rpx; }
.smart-quote-val { color: var(--ink); font-size: 25rpx; font-weight: 600; }

.smart-disclaimer {
  margin: 18rpx 20rpx 0; padding: 18rpx;
  background: #FBEFE4; border: 1rpx solid var(--line); border-radius: 12rpx;
  color: #9A5326; font-size: 21rpx; line-height: 1.6;
}
