.page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; background: #F5F8FF; }

.join-hero {
  position: relative;
  overflow: hidden;
  padding: 44rpx 34rpx 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(120deg, #FFFFFF 0%, #F1F7FF 54%, #F5F1FF 100%);
  border: 1rpx solid rgba(79, 125, 243, .2);
  box-shadow: 0 12rpx 32rpx rgba(35, 72, 140, .07);
}
.eyebrow { display: block; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; color: #4F7DF3; }
.title { display: block; margin-top: 14rpx; font-size: 44rpx; font-weight: 820; color: #0B1F33; }
.desc { display: block; margin-top: 16rpx; font-size: 25rpx; line-height: 1.85; color: #52657F; }
.hero-stats { display: flex; gap: 14rpx; margin: 28rpx 0; }
.hero-stats > view { flex: 1; display: flex; flex-direction: column; gap: 6rpx; padding: 18rpx 14rpx; border-radius: 18rpx; background: rgba(255,255,255,.9); border: 1rpx solid rgba(79,125,243,.16); }
.num { font-size: 30rpx; font-weight: 820; color: #2B4BC4; }
.cap { font-size: 20rpx; color: #7A8BA5; }
.btn-primary { margin-top: 6rpx; background: linear-gradient(100deg, #4F7DF3, #6C5CE7); color: #FFFFFF; font-size: 28rpx; font-weight: 700; border-radius: 16rpx; }
.hero-link { margin-top: 22rpx; text-align: center; font-size: 24rpx; color: #4F7DF3; }

.section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 42rpx 6rpx 18rpx; font-size: 30rpx; font-weight: 780; color: #0B1F33; }
.section-sub { font-size: 21rpx; font-weight: 400; color: #8A9AAE; }

.plan {
  position: relative;
  margin-bottom: 20rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E3EBF8;
  box-shadow: 0 8rpx 24rpx rgba(35, 72, 140, .05);
}
.plan.hot { border-color: rgba(124, 92, 240, .45); }
.plan-tag { position: absolute; top: -16rpx; right: 26rpx; padding: 6rpx 20rpx; border-radius: 999rpx; background: linear-gradient(100deg, #4F7DF3, #7C5CF0); color: #fff; font-size: 20rpx; font-weight: 700; }
.plan-name { font-size: 32rpx; font-weight: 800; color: #0B1F33; }
.plan-sub { margin-top: 6rpx; font-size: 22rpx; color: #8A9AAE; }
.plan-price { display: flex; align-items: baseline; gap: 14rpx; margin: 24rpx 0; padding-bottom: 22rpx; border-bottom: 1rpx dashed #DCE6F5; }
.plan-price .big { font-size: 48rpx; font-weight: 830; color: #2B4BC4; }
.plan-price .unit { font-size: 21rpx; color: #8A9AAE; }
.fee { display: flex; justify-content: space-between; padding: 7rpx 0; font-size: 23rpx; color: #66799A; }
.fee .b { font-weight: 700; color: #233B5D; }
.divider { height: 1rpx; margin: 18rpx 0; background: #EDF2FA; }
.perk { position: relative; padding-left: 28rpx; margin-bottom: 10rpx; font-size: 23rpx; line-height: 1.6; color: #4A5C75; }
.tick { position: absolute; left: 0; color: #16A34A; font-weight: 800; }
.fineprint { margin: 16rpx 6rpx 0; font-size: 21rpx; line-height: 1.8; color: #8A9AAE; }

.flow { display: flex; flex-direction: column; gap: 14rpx; }
.flow > view { display: flex; flex-direction: column; gap: 6rpx; padding: 22rpx 24rpx; border-radius: 20rpx; background: #FFFFFF; border: 1rpx solid #E3EBF8; }
.flow-no { font-size: 21rpx; font-weight: 820; letter-spacing: 2rpx; color: #4F7DF3; }
.flow-title { font-size: 26rpx; font-weight: 720; color: #0B1F33; }
.flow-desc { font-size: 21rpx; color: #7A8BA5; }

.card { padding: 26rpx 28rpx; border-radius: 22rpx; background: #FFFFFF; border: 1rpx solid #E3EBF8; }
.pay-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 14rpx 0; border-bottom: 1rpx dashed #E4ECF8; font-size: 23rpx; color: #7A8BA5; }
.pay-row .b { color: #233B5D; font-weight: 650; text-align: right; word-break: break-all; }
.pay-note { margin-top: 18rpx; font-size: 21rpx; line-height: 1.8; color: #8A9AAE; }
