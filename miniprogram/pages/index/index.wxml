<view class="page">
  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-row">
      <view class="hero-brand">
        <text class="hero-logo">银川AIGC数字文化产业基地</text>
        <text class="hero-slogan">宁夏云辇文化科技有限公司</text>
      </view>
      <view class="hero-city">
        <text class="hero-city-icon">📍</text>
        <text class="hero-city-text">银川</text>
      </view>
    </view>

    <!-- 轮播 -->
    <swiper class="banner-swiper" indicator-dots="{{false}}" autoplay="{{true}}" circular="{{true}}" interval="4200" duration="420">
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-slug="{{item.link_value}}" data-type="{{item.link_type}}">
        <view class="banner {{item.themeClass}} {{item.hasImage ? 'banner-has-img' : ''}}" style="{{item.imageUrl ? 'background-image:url(' + item.imageUrl + ')' : ''}}">
          <view class="banner-inner">
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-sub">{{item.subtitle}}</text>
          </view>
          <text class="banner-mark" wx:if="{{!item.hasImage}}">MG</text>
        </view>
      </swiper-item>
    </swiper>

    <!-- 平台公告滚动栏（垂直轮播，数据来自云数据库） -->
    <view class="notice-bar" wx:if="{{notices.length}}">
      <view class="notice-label" bindtap="onNoticeAll">
        <text class="notice-label-icon">📢</text><text>公告</text>
      </view>
      <swiper class="notice-swiper" vertical="{{true}}" autoplay="{{notices.length > 1}}"
              circular="{{notices.length > 1}}" interval="3600" duration="420"
              bindchange="onNoticeChange" bindtap="onNoticeTap">
        <swiper-item wx:for="{{notices}}" wx:key="id">
          <view class="notice-item">
            <text class="notice-tag {{item.levelClass}}">{{item.tag}}</text>
            <text class="notice-title ellipsis">{{item.title}}</text>
            <text class="notice-arrow">›</text>
          </view>
        </swiper-item>
      </swiper>
      <view class="notice-more" bindtap="onNoticeAll">全部</view>
    </view>

    <!-- 企业商家入口 -->
    <view class="merchant-entry" bindtap="onMerchantEntry">
      <text class="merchant-entry-icon">🏬</text>
      <view class="merchant-entry-txt">
        <text class="merchant-entry-title">企业商家 · 在招任务</text>
        <text class="merchant-entry-sub">店铺主页 / 发布任务 / 参考视频</text>
      </view>
      <text class="merchant-entry-arrow">›</text>
    </view>

    <!-- 平台在线人数（真实心跳） -->
    <view class="online-bar">
      <view class="online-dot"></view>
      <text class="online-text">当前在线 <text class="online-num">{{onlineCount}}</text> 人</text>
      <text class="online-hint">实时</text>
    </view>
  </view>

  <!-- 分类 -->
  <view class="container section">
    <view class="section-head">
      <text class="section-title">服务分类</text>
      <text class="section-more" bindtap="onSeeAll">全部服务 ›</text>
    </view>
    <view class="cat-grid">
      <view class="cat-item {{item.imageUrl ? 'cat-item-has-img' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="onCategoryTap" data-slug="{{item.slug}}">
        <view class="cat-icon-wrap" wx:if="{{!item.imageUrl}}">
          <text class="cat-icon">{{item.icon}}</text>
        </view>
        <view class="cat-img-wrap" wx:else>
          <image class="cat-img" src="{{item.imageUrl}}" mode="aspectFill" />
        </view>
        <text class="cat-name">{{item.name}}</text>
        <text class="cat-desc ellipsis">{{item.description}}</text>
      </view>
    </view>
  </view>

  <!-- 热门服务 -->
  <view class="container section" wx:if="{{!loading}}">
    <view class="section-head">
      <text class="section-title">热销服务</text>
      <text class="section-sub">按销量排序</text>
      <text class="section-more" bindtap="onSeeAll">更多 ›</text>
    </view>

    <view class="svc-list">
      <view class="svc-item card" wx:for="{{hotServices}}" wx:key="id" bindtap="onServiceTap" data-id="{{item.id}}">
        <view class="svc-cover {{item.coverClass}}">
          <image wx:if="{{item.coverUrl}}" class="svc-cover-img" src="{{item.coverUrl}}" mode="aspectFill" />
          <text wx:else class="svc-cover-mark">MG</text>
        </view>
        <view class="svc-body">
          <text class="svc-title ellipsis">{{item.title}}</text>
          <text class="svc-sub ellipsis">{{item.subtitle}}</text>
          <view class="svc-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
          </view>
          <view class="svc-foot">
            <text class="svc-sales">已售 {{item.sales_count}}</text>
            <view class="svc-price">
              <text class="price"><text class="price-symbol">¥</text><text class="price-value">{{item.priceText}}</text></text>
              <text class="price-old" wx:if="{{item.oldPriceText}}">¥{{item.oldPriceText}}</text>
              <text class="price-unit">/{{item.unit}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐服务者 -->
  <view class="container section" wx:if="{{!loading && providers.length}}">
    <view class="section-head">
      <text class="section-title">推荐服务者</text>
      <text class="section-sub">按完成单量</text>
    </view>
    <view class="prov-list">
      <view class="prov-item card" wx:for="{{providers}}" wx:key="id" bindtap="onProviderTap" data-id="{{item.id}}">
        <view class="avatar avatar-md"><text>{{item.initial}}</text></view>
        <view class="prov-body">
          <view class="prov-name-row">
            <text class="prov-name">{{item.nickname}}</text>
            <text class="prov-verified" wx:if="{{item.is_verified}}">✓ 认证</text>
          </view>
          <view class="prov-meta">
            <text class="prov-rate">★ {{item.ratingText}}</text>
            <text class="prov-dot">·</text>
            <text class="prov-count">完成 {{item.orders_done}} 单</text>
            <text class="prov-dot">·</text>
            <text class="prov-count">{{item.city}}</text>
          </view>
        </view>
        <text class="prov-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 平台说明 -->
  <view class="container section" wx:if="{{settings}}">
    <view class="notice card card-pad">
      <text class="notice-title">平台规则</text>
      <text class="notice-text">{{settings.notice}}</text>
      <text class="notice-text">最低下单金额 ¥{{settings.min_order_amount / 100}}，服务热线 {{settings.support_phone}}</text>
    </view>
  </view>

  <view class="loading-box" wx:if="{{loading}}">正在加载…</view>
</view>
