<view class="page">
  <!-- 顶部：品牌 + 轮播 + 工作台 -->
  <view class="hero">
    <view class="hero-row">
      <view class="hero-brand">
        <text class="hero-logo">银川AIGC数字文化产业基地</text>
        <text class="hero-slogan">宁夏云辇文化科技有限公司</text>
      </view>
      <view class="hero-city">
        <text class="hero-city-icon">📍</text>
        <text class="hero-city-text">银川</text>
      </view>
    </view>

    <swiper class="banner-swiper" indicator-dots="{{false}}" autoplay="{{true}}" circular="{{true}}" interval="4200" duration="420">
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-slug="{{item.link_value}}" data-type="{{item.link_type}}">
        <!-- 整幅包内主题插画。用 <image> 而不是 WXSS background-image：小程序样式不能引用包内本地图。 -->
        <view class="banner banner-has-img">
          <image class="banner-bg-img" src="{{item.imageUrl}}" mode="aspectFill"
                 data-field="banners" data-idx="{{index}}" data-key="imageUrl"
                 data-fallback="{{item.localImage}}" binderror="onImageFallback" />
          <!-- 实拍照片亮度不可控：文字区加暖褐暗角，保证任何底图都读得清 -->
          <view class="banner-scrim"></view>
          <view class="banner-inner">
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-sub">{{item.subtitle}}</text>
          </view>
          <text class="banner-hud hud-num">● ONLINE {{onlineCount}} // YINCHUAN AIGC</text>
        </view>
      </swiper-item>
    </swiper>

    <!-- 工作台统计：与「订单」页同口径，点任意格进抢单大厅 -->
    <view class="work-grid">
      <view class="work-cell" bindtap="onGoHall">
        <text class="work-num hud-num">{{work.pending}}</text>
        <text class="work-label">待实施</text>
      </view>
      <view class="work-cell" bindtap="onGoHall">
        <text class="work-num hud-num">{{work.doing}}</text>
        <text class="work-label">进行中</text>
      </view>
      <view class="work-cell" bindtap="onGoHall">
        <text class="work-num hud-num">{{work.check}}</text>
        <text class="work-label">待验收</text>
      </view>
      <view class="work-cell">
        <text class="work-num hud-num">{{work.refund}}</text>
        <text class="work-label">退款中</text>
      </view>
      <view class="work-cell">
        <text class="work-num hud-num">{{work.done}}</text>
        <text class="work-label">交易完成</text>
      </view>
      <view class="work-cell">
        <text class="work-num hud-num">{{work.closed}}</text>
        <text class="work-label">交易关闭</text>
      </view>
    </view>

    <!-- 快捷入口：把散落的入口收成 4 个 -->
    <view class="quick-grid">
      <view class="quick-item" bindtap="onGoHall">
        <text class="quick-icon">⚡</text>
        <text class="quick-label">抢单大厅</text>
      </view>
      <view class="quick-item" bindtap="onGoPublish">
        <text class="quick-icon">📝</text>
        <text class="quick-label">发布需求</text>
      </view>
      <view class="quick-item" bindtap="onGoIncome">
        <text class="quick-icon">💰</text>
        <text class="quick-label">我的收入</text>
      </view>
      <view class="quick-item" bindtap="onMerchantEntry">
        <text class="quick-icon">🏬</text>
        <text class="quick-label">企业商家</text>
      </view>
    </view>

    <!-- 公告：只留一条滚动条，在线人数已并入轮播 HUD -->
    <view class="notice-bar" wx:if="{{notices.length}}">
      <view class="notice-label" bindtap="onNoticeAll">
        <text class="notice-label-icon">📢</text><text>公告</text>
      </view>
      <swiper class="notice-swiper" vertical="{{true}}" autoplay="{{notices.length > 1}}"
              circular="{{notices.length > 1}}" interval="3600" duration="420"
              bindchange="onNoticeChange" bindtap="onNoticeTap">
        <swiper-item wx:for="{{notices}}" wx:key="id">
          <view class="notice-item">
            <text class="notice-tag {{item.levelClass}}">{{item.tag}}</text>
            <text class="notice-title ellipsis">{{item.title}}</text>
            <text class="notice-arrow">›</text>
          </view>
        </swiper-item>
      </swiper>
      <view class="notice-more" bindtap="onNoticeAll">全部</view>
    </view>
  </view>

  <!-- 业务分类：8 类归成 拍摄制作 / 后期剪辑 / AI 创作 -->
  <view class="container section">
    <view class="section-head">
      <text class="section-title">业务分类</text>
      <text class="section-more" bindtap="onSeeAll">全部服务 ›</text>
    </view>

    <view class="cat-group" wx:for="{{catGroups}}" wx:key="key" wx:for-item="g" wx:for-index="gi">
      <view class="cat-group-head">
        <text class="cat-group-name">{{g.name}}</text>
        <text class="cat-group-desc">{{g.desc}}</text>
      </view>
      <view class="cat-chips">
        <view class="cat-chip" wx:for="{{g.items}}" wx:key="id" bindtap="onCategoryTap" data-slug="{{item.slug}}">
          <image class="cat-chip-img" src="{{item.imageUrl}}" mode="aspectFill"
                 data-field="catGroups[{{gi}}].items" data-idx="{{index}}" data-key="imageUrl"
                 data-fallback="{{item.localImage}}" binderror="onImageFallback" />
          <text class="cat-chip-name">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 精选服务：只留 3 条 -->
  <view class="container section" wx:if="{{!loading}}">
    <view class="section-head">
      <text class="section-title">精选服务</text>
      <text class="section-sub">按销量</text>
      <text class="section-more" bindtap="onSeeAll">更多 ›</text>
    </view>

    <view class="svc-list">
      <view class="svc-item card" wx:for="{{hotServices}}" wx:key="id" bindtap="onServiceTap" data-id="{{item.id}}">
        <view class="svc-cover {{item.coverClass}}">
          <image class="svc-cover-img" src="{{item.coverUrl}}" mode="aspectFill"
                 data-field="hotServices" data-idx="{{index}}" data-key="coverUrl"
                 data-fallback="{{item.localCover}}" binderror="onImageFallback" />
        </view>
        <view class="svc-body">
          <text class="svc-title ellipsis">{{item.title}}</text>
          <text class="svc-sub ellipsis">{{item.subtitle}}</text>
          <view class="svc-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
          </view>
          <view class="svc-foot">
            <text class="svc-sales">已售 {{item.sales_count}}</text>
            <view class="svc-price">
              <text class="price"><text class="price-symbol">¥</text><text class="price-value">{{item.priceText}}</text></text>
              <text class="price-old" wx:if="{{item.oldPriceText}}">¥{{item.oldPriceText}}</text>
              <text class="price-unit">/{{item.unit}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐服务者：横滑，不占纵向空间 -->
  <view class="container section" wx:if="{{!loading && providers.length}}">
    <view class="section-head">
      <text class="section-title">推荐服务者</text>
      <text class="section-sub">按完成单量</text>
    </view>
    <scroll-view class="prov-scroll" scroll-x enable-flex>
      <view class="prov-card" wx:for="{{providers}}" wx:key="id" bindtap="onProviderTap" data-id="{{item.id}}">
        <view class="avatar avatar-md"><text>{{item.initial}}</text></view>
        <text class="prov-name ellipsis">{{item.nickname}}</text>
        <view class="prov-meta">
          <text class="prov-rate">★ {{item.ratingText}}</text>
          <text class="prov-count">完成 {{item.orders_done}} 单</text>
        </view>
        <text class="prov-verified" wx:if="{{item.is_verified}}">✓ 认证</text>
      </view>
    </scroll-view>
  </view>

  <!-- 平台规则：压成一行 -->
  <view class="container section" wx:if="{{settings}}">
    <view class="rule-line card">
      <text class="rule-title">平台规则</text>
      <text class="rule-text ellipsis">{{settings.notice}}</text>
      <text class="rule-more" bindtap="onSeeAll">›</text>
    </view>
  </view>

  <view class="loading-box" wx:if="{{loading}}">正在加载…</view>
</view>
