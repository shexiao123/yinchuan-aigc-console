.hero {
  padding: 32rpx 28rpx 8rpx;
}

.hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.hero-brand {
  display: flex;
  flex-direction: column;
}

.hero-logo {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--ink);
  line-height: 1.35;
}

.hero-slogan {
  font-size: 22rpx;
  color: var(--brand-deep);
  margin-top: 6rpx;
  letter-spacing: .5rpx;
  font-weight: 500;
}

.hero-city {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 22rpx;
  background: var(--card);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
  margin-top: 8rpx;
}

.hero-city-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.hero-city-text {
  font-size: 24rpx;
  color: var(--ink-2);
}

/* ---------------- 轮播 ---------------- */

.banner-swiper {
  height: 260rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner {
  height: 260rpx;
  border-radius: 24rpx;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  overflow: hidden;
}

/* 蓝色科技动态背景：三档主题统一为浅蓝实色，与网页端首屏一致 */
.banner-amber { background: linear-gradient(120deg, #F2F8FF 0%, #D8EAFF 100%); }
.banner-olive { background: linear-gradient(120deg, #EAF7FF 0%, #CDEBFF 100%); }
.banner-rose { background: linear-gradient(120deg, #F0F4FF 0%, #DDE7FF 100%); }

.tech-motion {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 0;
  overflow: hidden;
  background: linear-gradient(120deg, #F7FBFF 0%, #E4F0FF 55%, #C7DFFF 100%);
}
/* 整幅科技底图（最底层）：给画面「面」与色彩层次，动画层叠在其上 */
.tech-stage-img {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 0;
}
.tech-grid {
  position: absolute; left: -40rpx; top: -40rpx; right: -40rpx; bottom: -40rpx;
  background-image:
    repeating-linear-gradient(0deg, rgba(79, 125, 243, .20) 0 2rpx, transparent 2rpx 28rpx),
    repeating-linear-gradient(90deg, rgba(79, 125, 243, .20) 0 2rpx, transparent 2rpx 28rpx);
  animation: techGridDrift 14s linear infinite;
}
/* 城市天际线：三层错落楼体柱条，与网页端 Canvas 都市剪影同源 */
.tech-city {
  position: absolute; left: 0; right: 0; bottom: 0; height: 124rpx;
  background-image:
    linear-gradient(rgba(79, 125, 243, .22), rgba(79, 125, 243, .22)),
    linear-gradient(rgba(79, 125, 243, .16), rgba(79, 125, 243, .16)),
    linear-gradient(rgba(79, 125, 243, .11), rgba(79, 125, 243, .11));
  background-repeat: repeat-x;
  background-size: 46rpx 78rpx, 34rpx 112rpx, 62rpx 56rpx;
  background-position: 0 bottom, 14rpx bottom, 30rpx bottom;
}
.tech-windows {
  position: absolute; left: 0; right: 0; bottom: 0; height: 108rpx;
  background-image: radial-gradient(circle, rgba(255, 255, 255, .90) 1.5rpx, transparent 2rpx);
  background-size: 15rpx 17rpx;
}
/* 斜向流动光轨 */
.tech-beam {
  position: absolute; top: -80rpx; left: -180rpx; width: 180rpx; height: 460rpx;
  background: linear-gradient(180deg, rgba(14, 165, 233, 0), rgba(14, 165, 233, .24) 46%, rgba(124, 92, 240, 0));
  transform: rotate(26deg);
  animation: techBeamMove 9s linear infinite;
}
.tech-beam-2 {
  background: linear-gradient(180deg, rgba(124, 92, 240, 0), rgba(124, 92, 240, .18) 46%, rgba(14, 165, 233, 0));
  animation-duration: 13s;
  animation-delay: -5s;
}
/* 底部数据波形 */
.tech-wave {
  position: absolute; left: 0; right: 0; bottom: 0; height: 40rpx;
  border-top: 2rpx solid rgba(14, 165, 233, .38);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  background: linear-gradient(180deg, rgba(14, 165, 233, .14), rgba(14, 165, 233, 0));
  animation: techWaveSwing 6s ease-in-out infinite alternate;
}
/* 右上数据刻度 */
.tech-hud {
  position: absolute; right: 26rpx; top: 20rpx; width: 132rpx; height: 14rpx;
  background-image: repeating-linear-gradient(90deg, rgba(79, 125, 243, .46) 0 2rpx, transparent 2rpx 12rpx);
}
.tech-scan {
  position: absolute; left: 0; right: 0; top: -140rpx; height: 140rpx;
  background: linear-gradient(180deg, #E4F0FF 0%, #BBD8FA 50%, #E4F0FF 100%);
  animation: techScanDown 7s linear infinite;
}
.tech-ring {
  position: absolute; right: 46rpx; top: 34rpx; width: 110rpx; height: 110rpx;
  border: 3rpx solid #9CC4F2; border-radius: 50%;
  animation: techRingPulse 6s ease-out infinite;
}
@keyframes techGridDrift {
  from { transform: translateY(0); }
  to { transform: translateY(28rpx); }
}
@keyframes techScanDown {
  from { top: -140rpx; }
  to { top: 300rpx; }
}
@keyframes techRingPulse {
  0% { transform: scale(.4); border-color: #9CC4F2; }
  100% { transform: scale(2.2); border-color: #E4F0FF; }
}
@keyframes techBeamMove {
  from { left: -180rpx; }
  to { left: 780rpx; }
}
@keyframes techWaveSwing {
  from { transform: scaleY(.7) translateY(6rpx); }
  to { transform: scaleY(1.25) translateY(-4rpx); }
}

.banner-inner {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}

.banner-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #0B1F33;
  letter-spacing: 2rpx;
}

.banner-sub {
  font-size: 24rpx;
  color: #40536B;
  margin-top: 12rpx;
}

/* 浅蓝动态底 + 浅色插图，文字统一深色（不再靠深色不透明蒙层） */
.banner-tech .banner-title { color: #0B1F33; }
.banner-tech .banner-sub { color: #4A5B6E; }

.banner-mark {
  position: absolute;
  right: 30rpx;
  bottom: -30rpx;
  z-index: 1;
  font-size: 140rpx;
  font-weight: 800;
  color: #BED4F2;
  letter-spacing: 6rpx;
}

/* ---------------- 分类 ---------------- */

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.cat-item {
  /* 有配图后 3 列太挤（卡宽仅 210rpx），改 2 列 */
  width: calc((100% - 20rpx) / 2);
  background: var(--card);
  border-radius: 22rpx;
  padding: 24rpx 16rpx 20rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cat-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.cat-icon {
  font-size: 38rpx;
}

.cat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.cat-desc {
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 6rpx;
  width: 100%;
}

/* ---------------- 服务列表 ---------------- */

.svc-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.svc-item {
  display: flex;
}

.svc-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.svc-cover-mark {
  font-size: 44rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.32);
  letter-spacing: 4rpx;
}

.svc-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.svc-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.svc-sub {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

.svc-tags {
  margin-top: 12rpx;
  flex: 1;
}

.svc-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 8rpx;
}

.svc-sales {
  font-size: 22rpx;
  color: var(--ink-3);
}

.svc-price {
  display: flex;
  align-items: baseline;
}

/* ---------------- 服务者 ---------------- */

.prov-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.prov-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.prov-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.prov-name-row {
  display: flex;
  align-items: center;
}

.prov-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.prov-verified {
  font-size: 20rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.prov-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.prov-rate {
  color: var(--brand);
  font-weight: 500;
}

.prov-dot {
  margin: 0 10rpx;
}

.prov-arrow {
  font-size: 34rpx;
  color: #CFC4BA;
}

/* ---------------- 平台说明 ---------------- */

.notice {
  background: linear-gradient(135deg, #FBF3EA, #F7EFE4);
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-deep);
  margin-bottom: 10rpx;
}

.notice-text {
  display: block;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.8;
}

/* 服务封面图 */
.svc-cover-img {
  width: 100%;
  height: 100%;
}

/* ---------------- 主视觉背景图 ---------------- */
.banner-has-img {
  background-size: cover;
  background-position: center 42%;
  background-repeat: no-repeat;
}
/* 插图不叠任何不透明蒙层：保证图片本身清晰可见 */
.banner-has-img::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: none;
  z-index: 1;
}
.banner-has-img .banner-inner { position: relative; z-index: 2; }
.banner-has-img .banner-sub { max-width: 460rpx; }

/* ---------------- 分类配图 ---------------- */
/* 有配图的分类卡：图片通栏在上，文字在下 */
.cat-item-has-img {
  padding: 0 0 20rpx;
  align-items: stretch;
  overflow: hidden;
}
.cat-img-wrap {
  display: block;
  width: 100%;
  height: 150rpx;
  overflow: hidden;
  background: var(--brand-soft);
}
.cat-img {
  width: 100%;
  height: 100%;
  display: block;
}
.cat-item-has-img .cat-name {
  margin-top: 16rpx;
  text-align: center;
}
.cat-item-has-img .cat-desc {
  text-align: center;
  margin-top: 4rpx;
}

/* 平台在线人数（真实心跳） */
.online-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 0 4rpx;
  padding: 14rpx 20rpx;
  background: #E9F8F6;
  border: 1rpx solid rgba(34, 184, 166, .22);
  border-radius: 999rpx;
}
.online-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #22B8A6;
  flex: none;
  animation: onlinePulse 1.8s infinite;
}
@keyframes onlinePulse {
  0%   { box-shadow: 0 0 0 0 rgba(34, 184, 166, .55); }
  70%  { box-shadow: 0 0 0 12rpx rgba(34, 184, 166, 0); }
  100% { box-shadow: 0 0 0 0 rgba(34, 184, 166, 0); }
}
.online-text {
  font-size: 24rpx;
  color: #147D72;
  font-weight: 600;
}
.online-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #0B6F66;
}
.online-hint {
  margin-left: auto;
  font-size: 20rpx;
  color: #6FA79E;
}

/* 企业商家入口 */
.merchant-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 20rpx 0 0;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(110deg, #EAF3FE, #F0EEFD 60%, #F8F4FF);
  border: 1rpx solid rgba(79, 125, 243, .18);
}
.merchant-entry-icon { font-size: 40rpx; }
.merchant-entry-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.merchant-entry-title { font-size: 27rpx; font-weight: 700; color: #0F172A; }
.merchant-entry-sub { font-size: 21rpx; color: #475569; }
.merchant-entry-arrow { font-size: 40rpx; color: #4F7DF3; }

/* 平台公告滚动栏（垂直轮播） */
.notice-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 68rpx;
  box-sizing: border-box;
  margin: 20rpx 0 0;
  padding: 0 16rpx 0 8rpx;
  background: #F3F8FF;
  border: 1rpx solid rgba(79, 125, 243, .14);
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, .05);
}
.notice-label {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(120deg, #0EA5E9, #4F7DF3 58%, #7C5CF0);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}
.notice-label-icon { font-size: 22rpx; }
.notice-swiper {
  flex: 1;
  min-width: 0;
  height: 52rpx;
}
.notice-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 52rpx;
  padding: 0 2rpx;
}
.notice-tag {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: #0369A1;
  background: #E4F5FD;
  border: 1rpx solid rgba(14, 165, 233, .18);
}
.notice-tag.nt-activity {
  color: #6D28D9;
  background: #F2EFFE;
  border-color: rgba(124, 92, 240, .20);
}
.notice-tag.nt-important {
  color: #B91C1C;
  background: #FCECF3;
  border-color: rgba(219, 39, 119, .20);
}
.notice-title {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #475569;
}
.notice-arrow {
  flex: none;
  font-size: 28rpx;
  color: #94A3B8;
}
.notice-more {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: #0284C7;
}
