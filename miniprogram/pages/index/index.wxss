.hero {
  padding: 32rpx 28rpx 8rpx;
}

.hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.hero-brand {
  display: flex;
  flex-direction: column;
}

.hero-logo {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--ink);
  line-height: 1.35;
}

.hero-slogan {
  font-size: 22rpx;
  color: var(--brand-deep);
  margin-top: 6rpx;
  letter-spacing: .5rpx;
  font-weight: 500;
}

/* ---------------- 轮播 ---------------- */

.banner-swiper {
  /* 750 : 360 ≈ 2.08 : 1，与包内 mp-banner-N.jpg 的 900x432 完全同比例，不裁主体 */
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner {
  height: 360rpx;
  border-radius: 24rpx;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  overflow: hidden;
  background: var(--bg);
}

/* 暖调背景：三档主题统一为米色实色，图片加载失败也不会露出冷蓝 */
.banner-amber { background: linear-gradient(120deg, #FBF1E2 0%, #F0DCC0 100%); }
.banner-olive { background: linear-gradient(120deg, #F7F2E6 0%, #E7DCC6 100%); }
.banner-rose { background: linear-gradient(120deg, #FBF0EA 0%, #EFD9CE 100%); }

.tech-motion {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 0;
  overflow: hidden;
  background: linear-gradient(120deg, #FDF7ED 0%, #F5E9D6 55%, #EBD9BE 100%);
}
/* 整幅科技底图（最底层）：给画面「面」与色彩层次，动画层叠在其上 */
.tech-stage-img {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 0;
}
.tech-grid {
  position: absolute; left: -40rpx; top: -40rpx; right: -40rpx; bottom: -40rpx;
  background-image:
    repeating-linear-gradient(0deg, rgba(79, 125, 243, .20) 0 2rpx, transparent 2rpx 28rpx),
    repeating-linear-gradient(90deg, rgba(79, 125, 243, .20) 0 2rpx, transparent 2rpx 28rpx);
  animation: techGridDrift 14s linear infinite;
}
/* 城市天际线：三层错落楼体柱条，与网页端 Canvas 都市剪影同源 */
.tech-city {
  position: absolute; left: 0; right: 0; bottom: 0; height: 124rpx;
  background-image:
    linear-gradient(rgba(79, 125, 243, .22), rgba(79, 125, 243, .22)),
    linear-gradient(rgba(79, 125, 243, .16), rgba(79, 125, 243, .16)),
    linear-gradient(rgba(79, 125, 243, .11), rgba(79, 125, 243, .11));
  background-repeat: repeat-x;
  background-size: 46rpx 78rpx, 34rpx 112rpx, 62rpx 56rpx;
  background-position: 0 bottom, 14rpx bottom, 30rpx bottom;
}
.tech-windows {
  position: absolute; left: 0; right: 0; bottom: 0; height: 108rpx;
  background-image: radial-gradient(circle, rgba(255, 255, 255, .90) 1.5rpx, transparent 2rpx);
  background-size: 15rpx 17rpx;
}
/* 斜向流动光轨 */
.tech-beam {
  position: absolute; top: -80rpx; left: -180rpx; width: 180rpx; height: 460rpx;
  background: linear-gradient(180deg, rgba(14, 165, 233, 0), rgba(14, 165, 233, .24) 46%, rgba(124, 92, 240, 0));
  transform: rotate(26deg);
  animation: techBeamMove 9s linear infinite;
}
.tech-beam-2 {
  background: linear-gradient(180deg, rgba(124, 92, 240, 0), rgba(124, 92, 240, .18) 46%, rgba(14, 165, 233, 0));
  animation-duration: 13s;
  animation-delay: -5s;
}
/* 底部数据波形 */
.tech-wave {
  position: absolute; left: 0; right: 0; bottom: 0; height: 40rpx;
  border-top: 2rpx solid rgba(14, 165, 233, .38);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  background: linear-gradient(180deg, rgba(14, 165, 233, .14), rgba(14, 165, 233, 0));
  animation: techWaveSwing 6s ease-in-out infinite alternate;
}
/* 右上数据刻度 */
.tech-hud {
  position: absolute; right: 26rpx; top: 20rpx; width: 132rpx; height: 14rpx;
  background-image: repeating-linear-gradient(90deg, rgba(79, 125, 243, .46) 0 2rpx, transparent 2rpx 12rpx);
}
.tech-scan {
  position: absolute; left: 0; right: 0; top: -140rpx; height: 140rpx;
  background: linear-gradient(180deg, #E4F0FF 0%, #BBD8FA 50%, #E4F0FF 100%);
  animation: techScanDown 7s linear infinite;
}
.tech-ring {
  position: absolute; right: 46rpx; top: 34rpx; width: 110rpx; height: 110rpx;
  border: 3rpx solid #9CC4F2; border-radius: 50%;
  animation: techRingPulse 6s ease-out infinite;
}
/* 深海全息层：细线数据雨 + 四角括号 + 等宽仪表读数。
   全部是 1px 实线，不用模糊、不用毛玻璃、不叠不透明蒙层。 */
.tech-rain {
  position: absolute; left: -20%; top: -80rpx; width: 140%; height: 420rpx;
  background-image: repeating-linear-gradient(104deg,
    rgba(10, 165, 180, 0) 0 22rpx,
    rgba(10, 165, 180, .22) 22rpx 23rpx,
    rgba(10, 165, 180, 0) 23rpx 46rpx);
  animation: techRainFall 5.5s linear infinite;
}
@keyframes techRainFall {
  from { transform: translateY(-70rpx); }
  to { transform: translateY(70rpx); }
}
.tech-bracket {
  position: absolute; width: 34rpx; height: 34rpx; z-index: 1;
  border: 2rpx solid rgba(47, 107, 234, .55);
}
.tech-bracket-tl { left: 16rpx; top: 16rpx; border-right: none; border-bottom: none; }
.tech-bracket-br { right: 16rpx; bottom: 16rpx; border-left: none; border-top: none; }
.tech-readout {
  position: absolute; left: 30rpx; bottom: 20rpx; z-index: 1;
  font-size: 19rpx; color: #0B6F7A; opacity: .85;
}
@keyframes techGridDrift {
  from { transform: translateY(0); }
  to { transform: translateY(28rpx); }
}
@keyframes techScanDown {
  from { top: -140rpx; }
  to { top: 300rpx; }
}
@keyframes techRingPulse {
  0% { transform: scale(.4); border-color: #9CC4F2; }
  100% { transform: scale(2.2); border-color: #E4F0FF; }
}
@keyframes techBeamMove {
  from { left: -180rpx; }
  to { left: 780rpx; }
}
@keyframes techWaveSwing {
  from { transform: scaleY(.7) translateY(6rpx); }
  to { transform: scaleY(1.25) translateY(-4rpx); }
}

/* 轮播文字暗角：只在左侧文字区渐隐，不糊整幅照片 */
.banner-scrim {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 78%;
  z-index: 1;
  background: linear-gradient(100deg, rgba(43, 26, 12, 0.76) 0%, rgba(43, 26, 12, 0.44) 46%, rgba(43, 26, 12, 0) 88%);
}

.banner-inner {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
  max-width: 560rpx;
}

.banner-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  /* 实拍照片亮度不可控，改用暖褐暗角 + 白字，保证任何底图都读得清 */
  color: #FFFFFF;
  text-shadow: 0 2rpx 10rpx rgba(60, 38, 18, 0.55);
}

.banner-sub {
  font-size: 24rpx;
  color: rgba(255, 250, 242, 0.92);
  margin-top: 12rpx;
  max-width: 460rpx;
  text-shadow: 0 1rpx 6rpx rgba(60, 38, 18, 0.5);
}

/* 右下角全息读数：实色暖白底 + 暖边，不叠模糊、不发灰 */
.banner-hud {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  z-index: 2;
  font-size: 18rpx;
  color: #7A4A12;
  background: var(--card);
  border: 1rpx solid rgba(180, 103, 31, 0.28);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

/* 浅蓝动态底 + 浅色插图，文字统一深色（不再靠深色不透明蒙层） */
.banner-tech .banner-title { color: #0B1F33; }
.banner-tech .banner-sub { color: #4A5B6E; }

.banner-mark {
  position: absolute;
  right: 30rpx;
  bottom: -30rpx;
  z-index: 1;
  font-size: 140rpx;
  font-weight: 800;
  color: #BED4F2;
  letter-spacing: 6rpx;
}

/* ---------------- 分类 ---------------- */

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.cat-item {
  /* 有配图后 3 列太挤（卡宽仅 210rpx），改 2 列 */
  width: calc((100% - 20rpx) / 2);
  background: var(--card);
  border-radius: 22rpx;
  padding: 24rpx 16rpx 20rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cat-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.cat-icon {
  font-size: 38rpx;
}

.cat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.cat-desc {
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 6rpx;
  width: 100%;
}

/* ---------------- 服务列表 ---------------- */

.svc-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.svc-item {
  display: flex;
}

.svc-cover {
  width: 200rpx;
  /* 不写死高度，跟随卡片由右侧内容撑出的实际高度，避免左下角露白 */
  height: auto;
  align-self: stretch;
  position: relative;
  overflow: hidden;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.svc-cover-mark {
  font-size: 44rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.32);
  letter-spacing: 4rpx;
}

.svc-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.svc-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.svc-sub {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

.svc-tags {
  margin-top: 12rpx;
  flex: 1;
}

.svc-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 8rpx;
}

.svc-sales {
  font-size: 22rpx;
  color: var(--ink-3);
}

.svc-price {
  display: flex;
  align-items: baseline;
}

/* ---------------- 服务者 ---------------- */

.prov-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.prov-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.prov-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.prov-name-row {
  display: flex;
  align-items: center;
}

.prov-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.prov-verified {
  font-size: 20rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.prov-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.prov-rate {
  color: var(--brand);
  font-weight: 500;
}

.prov-dot {
  margin: 0 10rpx;
}

.prov-arrow {
  font-size: 34rpx;
  color: #B9C9DE;
}

/* ---------------- 平台说明 ---------------- */

.notice {
  background: linear-gradient(135deg, #EAF3FF, #F0F6FF);
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-deep);
  margin-bottom: 10rpx;
}

.notice-text {
  display: block;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.8;
}

/* 服务封面图：绝对定位铺满封面区，父级高度由卡片内容决定 */
.svc-cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 快捷入口：4 个收口，圆形图标 + 标签 */
.quick-grid {
  display: flex;
  margin: 18rpx 20rpx 0;
  padding: 22rpx 8rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--brand-soft);
  font-size: 34rpx;
}

.quick-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

/* 智能工作台入口横条：独立一行，保留上面 4 个快捷格不挤位 */
.smart-entry-bar {
  display: flex; align-items: center;
  margin: 16rpx 20rpx 0; padding: 20rpx 18rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 14rpx;
}
.smart-entry-icon {
  flex: 0 0 64rpx; width: 64rpx; height: 64rpx; line-height: 64rpx;
  text-align: center; border-radius: 50%;
  background: #F5EADB; color: #A85A2D; font-size: 34rpx; margin-right: 18rpx;
}
.smart-entry-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.smart-entry-tag { color: #A85A2D; font-size: 19rpx; font-weight: 600; letter-spacing: 1rpx; }
.smart-entry-title { color: var(--ink); font-size: 26rpx; font-weight: 650; margin-top: 4rpx; }
.smart-entry-desc { color: var(--ink-3); font-size: 19rpx; margin-top: 4rpx; line-height: 1.45; }
.smart-entry-arrow { color: #B5793D; font-size: 44rpx; line-height: 1; margin-left: 10rpx; }

/* 业务分类分组：组标题 + 横向小卡，替代 8 张大卡 */
.cat-group {
  margin-top: 22rpx;
}

.cat-group:first-child {
  margin-top: 0;
}

.cat-group-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 14rpx;
}

.cat-group-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.cat-group-desc {
  margin-left: 14rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.cat-chips {
  display: flex;
  flex-wrap: wrap;
}

.cat-chip {
  width: calc(50% - 10rpx);
  margin: 0 20rpx 16rpx 0;
  display: flex;
  align-items: center;
  padding: 12rpx 14rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}

.cat-chip:nth-child(2n) {
  margin-right: 0;
}

.cat-chip-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: var(--brand-soft);
}

.cat-chip-name {
  margin-left: 16rpx;
  font-size: 25rpx;
  color: var(--ink);
  font-weight: 500;
}

/* 服务者横滑卡 */
.prov-scroll {
  display: flex;
  white-space: nowrap;
}

.prov-card {
  flex-shrink: 0;
  width: 220rpx;
  margin-right: 16rpx;
  padding: 22rpx 16rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prov-name {
  margin-top: 12rpx;
  max-width: 100%;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}

.prov-meta {
  margin-top: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prov-rate {
  font-size: 21rpx;
  color: #B0731F;
}

.prov-count {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.prov-verified {
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--cyan-soft);
  color: var(--olive);
  font-size: 19rpx;
}

/* 平台规则压成一行 */
.rule-line {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.rule-title {
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-right: 14rpx;
}

.rule-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--ink-3);
}

.rule-more {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 接单工作台统计格：冷白卡 + 冷蓝细线，数字走等宽字体 */
.work-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 22rpx 20rpx 0;
}

.work-cell {
  width: calc(33.333% - 16rpx);
  margin: 8rpx;
  padding: 20rpx 0;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.work-num {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--ink);
}

.work-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

/* ---------------- 主视觉背景图 ---------------- */
/* 整幅包内插画铺底：不叠任何不透明蒙层，图片本身清晰可见 */
.banner-bg-img {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  z-index: 0;
}
.banner-has-img {
  background-size: cover;
  background-position: center 42%;
  background-repeat: no-repeat;
}
/* 插图不叠任何不透明蒙层：保证图片本身清晰可见 */
.banner-has-img::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: none;
  z-index: 1;
}
.banner-has-img .banner-inner { position: relative; z-index: 2; }
.banner-has-img .banner-sub { max-width: 460rpx; }

/* ---------------- 分类配图 ---------------- */
/* 有配图的分类卡：图片通栏在上，文字在下 */
.cat-item-has-img {
  padding: 0 0 20rpx;
  align-items: stretch;
  overflow: hidden;
}
.cat-img-wrap {
  display: block;
  width: 100%;
  /* 2 列卡约 335rpx 宽，210rpx 高 ≈ 16:10，与 mp-cat-N.jpg 同比例不裁切 */
  height: 210rpx;
  overflow: hidden;
  background: var(--brand-soft);
}
.cat-img {
  width: 100%;
  height: 100%;
  display: block;
}
.cat-item-has-img .cat-name {
  margin-top: 16rpx;
  text-align: center;
}
.cat-item-has-img .cat-desc {
  text-align: center;
  margin-top: 4rpx;
}

/* 平台在线人数（真实心跳） */
.online-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 0 4rpx;
  padding: 14rpx 20rpx;
  background: #E9F8F6;
  border: 1rpx solid rgba(34, 184, 166, .22);
  border-radius: 999rpx;
}
.online-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #22B8A6;
  flex: none;
  animation: onlinePulse 1.8s infinite;
}
@keyframes onlinePulse {
  0%   { box-shadow: 0 0 0 0 rgba(34, 184, 166, .55); }
  70%  { box-shadow: 0 0 0 12rpx rgba(34, 184, 166, 0); }
  100% { box-shadow: 0 0 0 0 rgba(34, 184, 166, 0); }
}
.online-text {
  font-size: 24rpx;
  color: #147D72;
  font-weight: 600;
}
.online-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #0B6F66;
}
.online-hint {
  margin-left: auto;
  font-size: 20rpx;
  color: #6FA79E;
}

/* 企业商家入口 */
.merchant-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 20rpx 0 0;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(110deg, #EAF3FE, #F0EEFD 60%, #F8F4FF);
  border: 1rpx solid rgba(79, 125, 243, .18);
}
.merchant-entry-icon { font-size: 40rpx; }
.merchant-entry-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.merchant-entry-title { font-size: 27rpx; font-weight: 700; color: #0F172A; }
.merchant-entry-sub { font-size: 21rpx; color: #475569; }
.merchant-entry-arrow { font-size: 40rpx; color: #4F7DF3; }

/* 平台公告滚动栏（垂直轮播） */
.notice-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 68rpx;
  box-sizing: border-box;
  margin: 20rpx 0 0;
  padding: 0 16rpx 0 8rpx;
  background: #F7F1E6;
  border: 1rpx solid rgba(79, 125, 243, .14);
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, .05);
}
.notice-label {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(120deg, #0EA5E9, #4F7DF3 58%, #7C5CF0);
  color: var(--card);
  font-size: 22rpx;
  font-weight: 700;
}
.notice-label-icon { font-size: 22rpx; }
.notice-swiper {
  flex: 1;
  min-width: 0;
  height: 52rpx;
}
.notice-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 52rpx;
  padding: 0 2rpx;
}
.notice-tag {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: #0369A1;
  background: #E4F5FD;
  border: 1rpx solid rgba(14, 165, 233, .18);
}
.notice-tag.nt-activity {
  color: #6D28D9;
  background: #F2EFFE;
  border-color: rgba(124, 92, 240, .20);
}
.notice-tag.nt-important {
  color: #B91C1C;
  background: #FCECF3;
  border-color: rgba(219, 39, 119, .20);
}
.notice-title {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #475569;
}
.notice-arrow {
  flex: none;
  font-size: 28rpx;
  color: #94A3B8;
}
.notice-more {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: #0284C7;
}
