.hero {
  padding: 32rpx 28rpx 8rpx;
}

.hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.hero-brand {
  display: flex;
  flex-direction: column;
}

.hero-logo {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--ink);
  line-height: 1.35;
}

.hero-slogan {
  font-size: 22rpx;
  color: var(--brand-deep);
  margin-top: 6rpx;
  letter-spacing: .5rpx;
  font-weight: 500;
}

.hero-city {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 22rpx;
  background: var(--card);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
  margin-top: 8rpx;
}

.hero-city-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.hero-city-text {
  font-size: 24rpx;
  color: var(--ink-2);
}

/* ---------------- 轮播 ---------------- */

.banner-swiper {
  height: 260rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner {
  height: 260rpx;
  border-radius: 24rpx;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  overflow: hidden;
}

.banner-amber { background: linear-gradient(120deg, #E8B27A 0%, #C4703F 100%); }
.banner-olive { background: linear-gradient(120deg, #A8BC96 0%, #6E7F5C 100%); }
.banner-rose { background: linear-gradient(120deg, #D9A5A0 0%, #A5645F 100%); }

.banner-inner {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}

.banner-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.banner-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
  margin-top: 12rpx;
}

.banner-mark {
  position: absolute;
  right: 30rpx;
  bottom: -30rpx;
  font-size: 140rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.12);
  letter-spacing: 6rpx;
}

/* ---------------- 分类 ---------------- */

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.cat-item {
  /* 有配图后 3 列太挤（卡宽仅 210rpx），改 2 列 */
  width: calc((100% - 20rpx) / 2);
  background: var(--card);
  border-radius: 22rpx;
  padding: 24rpx 16rpx 20rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cat-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.cat-icon {
  font-size: 38rpx;
}

.cat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.cat-desc {
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 6rpx;
  width: 100%;
}

/* ---------------- 服务列表 ---------------- */

.svc-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.svc-item {
  display: flex;
}

.svc-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.svc-cover-mark {
  font-size: 44rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.32);
  letter-spacing: 4rpx;
}

.svc-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.svc-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.svc-sub {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

.svc-tags {
  margin-top: 12rpx;
  flex: 1;
}

.svc-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 8rpx;
}

.svc-sales {
  font-size: 22rpx;
  color: var(--ink-3);
}

.svc-price {
  display: flex;
  align-items: baseline;
}

/* ---------------- 服务者 ---------------- */

.prov-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.prov-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.prov-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.prov-name-row {
  display: flex;
  align-items: center;
}

.prov-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.prov-verified {
  font-size: 20rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.prov-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.prov-rate {
  color: var(--brand);
  font-weight: 500;
}

.prov-dot {
  margin: 0 10rpx;
}

.prov-arrow {
  font-size: 34rpx;
  color: #CFC4BA;
}

/* ---------------- 平台说明 ---------------- */

.notice {
  background: linear-gradient(135deg, #FBF3EA, #F7EFE4);
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-deep);
  margin-bottom: 10rpx;
}

.notice-text {
  display: block;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.8;
}

/* 服务封面图 */
.svc-cover-img {
  width: 100%;
  height: 100%;
}

/* ---------------- 主视觉背景图 ---------------- */
.banner-has-img {
  background-size: cover;
  background-position: center 42%;
  background-repeat: no-repeat;
}
/* 左侧蒙层：保证白字在照片上可读 */
.banner-has-img::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(100deg, rgba(24, 18, 13, 0.82) 0%, rgba(24, 18, 13, 0.58) 42%, rgba(24, 18, 13, 0.22) 100%);
  z-index: 1;
}
.banner-has-img .banner-inner { position: relative; z-index: 2; }
.banner-has-img .banner-sub { max-width: 460rpx; }

/* ---------------- 分类配图 ---------------- */
/* 有配图的分类卡：图片通栏在上，文字在下 */
.cat-item-has-img {
  padding: 0 0 20rpx;
  align-items: stretch;
  overflow: hidden;
}
.cat-img-wrap {
  display: block;
  width: 100%;
  height: 150rpx;
  overflow: hidden;
  background: var(--brand-soft);
}
.cat-img {
  width: 100%;
  height: 100%;
  display: block;
}
.cat-item-has-img .cat-name {
  margin-top: 16rpx;
  text-align: center;
}
.cat-item-has-img .cat-desc {
  text-align: center;
  margin-top: 4rpx;
}
