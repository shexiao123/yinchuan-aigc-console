.admin-head {
  padding: 36rpx 28rpx 44rpx;
  background: linear-gradient(140deg, #8FA9BF 0%, #5B7186 100%);
  display: flex;
  flex-direction: column;
}

.admin-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 3rpx;
}

.admin-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

.admin-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: -22rpx;
  position: relative;
  z-index: 2;
}

.admin-stat {
  width: calc((100% - 36rpx) / 3);
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx 0;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.admin-stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.admin-stat-label {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.admin-gmv {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #FBF3EA, #F7EFE4);
}

.admin-gmv-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 25rpx;
  color: var(--ink-2);
}

.admin-gmv-note {
  font-size: 21rpx;
  color: var(--ink-3);
}

.admin-gmv-value {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: var(--brand);
  margin-top: 12rpx;
}

.admin-mini {
  display: flex;
  background: var(--card);
  border-radius: 22rpx;
  box-shadow: var(--shadow);
  margin-top: 20rpx;
  padding: 24rpx 0;
}

.admin-mini-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid var(--line);
}

.admin-mini-item:last-child {
  border-right: none;
}

.admin-mini-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.admin-mini-label {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.filter-row {
  display: flex;
  padding: 0 0 20rpx;
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  margin-right: 14rpx;
  flex-shrink: 0;
  background: var(--card);
  box-shadow: var(--shadow);
}

.filter-chip-active {
  background: var(--brand);
  color: #fff;
  font-weight: 500;
}

.admin-order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 30rpx;
}

.admin-order {
  padding: 24rpx 26rpx;
}

.admin-order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.admin-order-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: 16rpx;
}

.admin-order-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.admin-order-no {
  font-size: 21rpx;
  color: var(--ink-3);
  font-family: 'SF Mono', Consolas, monospace;
}

.admin-order-time {
  font-size: 21rpx;
  color: var(--ink-3);
}

.admin-order-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.admin-order-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.admin-order-fee {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 激活管理员 */
.empty-btn {
  margin-top: 24rpx;
}
.activate-hint {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.6;
  margin: 12rpx 0 20rpx;
}
.activate-input {
  background: #F5EFE8;
  border-radius: 14rpx;
  padding: 0 24rpx;
  height: 84rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.activate-error {
  display: block;
  font-size: 24rpx;
  color: #A8463A;
  margin-top: 14rpx;
}
.activate-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ---------------- 可视化数据版（与网页端同源 tokens） ---------------- */

.viz-panel {
  background: rgba(28, 46, 76, .62);
  border: 1rpx solid rgba(120, 190, 230, .20);
  border-radius: 24rpx;
  padding: 26rpx 24rpx 20rpx;
  position: relative;
  overflow: hidden;
}

/* 顶部霓虹高光边 */
.viz-panel::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #22D3EE, transparent);
}

.viz-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.viz-head-left { display: flex; align-items: center; }
.viz-bar {
  width: 6rpx;
  height: 26rpx;
  background: linear-gradient(180deg, #22D3EE, #A78BFA);
  border-radius: 3rpx;
  margin-right: 14rpx;
}
.viz-title {
  color: #F4FAFF;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
.viz-sub { color: #94AEC6; font-size: 22rpx; }

.viz-canvas { display: block; }

.viz-donut-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.viz-legend { flex: 1; min-width: 0; }
.viz-legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.viz-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.viz-legend-name {
  flex: 1;
  min-width: 0;
  color: #C3D6E8;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.viz-legend-count {
  color: #F4FAFF;
  font-size: 26rpx;
  font-weight: 600;
}

.viz-video-wrap {
  margin-top: 12rpx;
}
.viz-video {
  width: 100%;
  height: 640rpx;
  border-radius: 20rpx;
  background: #0A1222;
}
.viz-video-tip {
  display: block;
  color: #94AEC6;
  font-size: 21rpx;
  margin-top: 12rpx;
  text-align: center;
}

/* 电影感背景层：固定在内容区顶部，pointer-events 穿透 */
.viz-bg {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
}
