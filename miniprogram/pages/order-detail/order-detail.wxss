.status-head {
  padding: 40rpx 32rpx 44rpx;
  background: linear-gradient(140deg, #E8B27A 0%, #C4703F 100%);
  display: flex;
  flex-direction: column;
}

.status-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.status-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  font-family: 'SF Mono', Consolas, monospace;
}

.block-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.timeline {
  padding-top: 4rpx;
}

.tl-item {
  display: flex;
}

.tl-dot-wrap {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-top: 10rpx;
  flex-shrink: 0;
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: var(--line);
  margin: 6rpx 0;
  min-height: 40rpx;
}

.tl-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 28rpx;
  padding-left: 12rpx;
}

.tl-text {
  display: block;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
}

.tl-time {
  display: block;
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.spec-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.spec-label {
  width: 150rpx;
  font-size: 25rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}

.spec-value {
  flex: 1;
  font-size: 25rpx;
  color: var(--ink);
}

.spec-value-wrap {
  line-height: 1.7;
}

.svc-card {
  display: flex;
  align-items: center;
}

.svc-card-body {
  flex: 1;
  min-width: 0;
}

.svc-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.svc-card-sub {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.prov-card {
  display: flex;
  align-items: center;
}

.prov-card-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.prov-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.prov-card-sub {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.prov-arrow {
  font-size: 36rpx;
  color: #CFC4BA;
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.fee-label {
  font-size: 26rpx;
  color: var(--ink-2);
}

.fee-value {
  font-size: 26rpx;
  color: var(--ink);
}

.fee-dim {
  color: var(--ink-3);
}

.fee-total-label {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
}

.fee-total {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand);
}

.action-cancel {
  width: 200rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.action-btn {
  flex: 1;
}
