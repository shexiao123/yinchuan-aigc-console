/* ---------------- 资料编辑 ---------------- */

.edit-loading {
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
  padding: 120rpx 0;
}

.edit-section {
  margin-top: 20rpx;
}

.edit-section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6rpx;
}

.edit-section-hint {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 20rpx;
  line-height: 1.5;
}

/* 头像 */
.edit-avatar-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.edit-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-avatar-img {
  width: 100%;
  height: 100%;
}

.edit-avatar-ph {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 600;
}

.edit-avatar-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46rpx;
  background: rgba(40, 30, 24, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-avatar-camera {
  font-size: 22rpx;
}

.edit-avatar-loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 30, 24, 0.5);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-avatar-side {
  flex: 1;
  min-width: 0;
}

.edit-avatar-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.edit-avatar-hint {
  display: block;
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.5;
}

.edit-avatar-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 字段 */
.edit-field {
  margin-top: 24rpx;
}

.edit-label {
  display: block;
  font-size: 25rpx;
  color: var(--ink-2);
  margin-bottom: 10rpx;
}

.edit-required {
  color: #A8463A;
  margin-left: 4rpx;
}

.edit-input {
  width: 100%;
  height: 82rpx;
  background: #F7F2EC;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 0 22rpx;
  font-size: 27rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.edit-input-inline {
  flex: 1;
  height: 70rpx;
}

.edit-textarea {
  width: 100%;
  min-height: 180rpx;
  background: #F7F2EC;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
  box-sizing: border-box;
}

.edit-count {
  display: block;
  text-align: right;
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* 选择器 */
.edit-picker {
  display: block;
}

.edit-picker-inner {
  height: 82rpx;
  background: #F7F2EC;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.edit-picker-text {
  font-size: 27rpx;
  color: var(--ink);
}

.edit-picker-muted {
  color: var(--ink-3);
}

.edit-picker-arrow {
  font-size: 30rpx;
  color: var(--ink-3);
}

/* 标签 */
.edit-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.edit-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--brand-soft);
  border: 1rpx solid rgba(180, 120, 60, 0.28);
  border-radius: 999rpx;
  padding: 8rpx 12rpx 8rpx 20rpx;
}

.edit-tag-text {
  font-size: 24rpx;
  color: var(--brand-deep);
}

.edit-tag-x {
  font-size: 26rpx;
  color: var(--brand);
  line-height: 1;
  padding: 0 6rpx;
}

.edit-tag-add {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.edit-preset-wrap {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.edit-preset-label {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}

.edit-preset-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.edit-preset {
  font-size: 23rpx;
  color: var(--ink-2);
  background: #F5EFE8;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.edit-preset-on {
  background: var(--brand-soft);
  border-color: rgba(180, 120, 60, 0.35);
  color: var(--brand-deep);
  font-weight: 600;
}

/* 开关行 */
.edit-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.edit-switch-text {
  flex: 1;
  min-width: 0;
}

.edit-switch-title {
  display: block;
  font-size: 26rpx;
  color: var(--ink);
}

.edit-switch-hint {
  display: block;
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 5rpx;
  line-height: 1.5;
}

/* 底部 */
.edit-error {
  text-align: center;
  color: #A8463A;
  font-size: 24rpx;
  margin-top: 24rpx;
}

.edit-save {
  margin-top: 40rpx;
}

.edit-foot {
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
  margin: 24rpx 0 20rpx;
}
