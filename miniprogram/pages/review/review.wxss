/* 订单摘要 */
.order-brief-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.order-brief-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.5;
}
.order-brief-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand-deep);
  flex-shrink: 0;
}
.order-brief-sub {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
}

/* 评分 */
.rating-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
}
.rating-star {
  font-size: 56rpx;
  color: #E0D6CC;
  line-height: 1;
  transition: color 0.15s;
  padding: 0 4rpx;
}
.rating-star.star-on {
  color: #E8A33D;
}
.rating-text {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 500;
}

/* 标签 */
.tag-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.tag-label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 16rpx;
}
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.tag-chip {
  font-size: 24rpx;
  color: var(--ink-2);
  background: #F5EFE8;
  border: 1rpx solid transparent;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  transition: all 0.15s;
}
.tag-chip.chip-on {
  color: #fff;
  background: var(--brand);
  border-color: var(--brand);
}

/* 评价内容 */
.review-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 18rpx;
  background: #F9F5F0;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
  box-sizing: border-box;
}
.word-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
}

/* 图片 */
.image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}
.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.image-thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #F3EDE6;
}
.image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(28, 24, 21, 0.78);
  color: #fff;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}
.image-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #D8CEC3;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.image-add-icon {
  font-size: 44rpx;
  color: #C4B8AC;
  line-height: 1;
}
.image-add-text {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 错误 */
.error-tip {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #FBEDEA;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #A8463A;
  line-height: 1.6;
}
.empty-gap {
  height: 24rpx;
}
