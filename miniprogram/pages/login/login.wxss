.login-page {
  min-height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
}

.login-bg {
  position: absolute;
  top: -180rpx;
  left: -120rpx;
  right: -120rpx;
  height: 560rpx;
  background: linear-gradient(160deg, #E8B27A 0%, #C4703F 55%, #A85A2D 100%);
  border-bottom-left-radius: 50%;
  border-bottom-right-radius: 50%;
  opacity: 0.9;
}

.login-top {
  position: relative;
  z-index: 2;
  padding-top: 140rpx;
  padding-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-logo {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
  text-align: center;
  line-height: 1.35;
}

.login-slogan {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 16rpx;
  letter-spacing: .5rpx;
}

.login-card {
  position: relative;
  z-index: 2;
  background: var(--card);
  border-radius: 30rpx;
  padding: 44rpx 36rpx 36rpx;
  box-shadow: var(--shadow-lg);
  margin-top: 20rpx;
}

.login-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.login-desc {
  display: block;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.8;
  margin-top: 16rpx;
}

.login-btn {
  margin-top: 40rpx;
}

.login-agree {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.check-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  border: 2rpx solid #D5C9BE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

.check-box-on {
  background: var(--brand);
  border-color: var(--brand);
}

.login-agree-text {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-left: 12rpx;
  flex: 1;
}

.login-error {
  margin-top: 24rpx;
  background: #FBEDEA;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
}

.login-error-text {
  font-size: 23rpx;
  color: #A8463A;
  line-height: 1.6;
}

.login-bottom {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 60rpx;
  position: relative;
  z-index: 2;
}

.login-note {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}
