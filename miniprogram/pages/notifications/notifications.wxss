/* 未读提示条 */
.notify-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--brand-soft);
  border-radius: 14rpx;
  margin-bottom: 20rpx;
}
.notify-bar-text {
  font-size: 26rpx;
  color: var(--brand-deep);
  font-weight: 500;
}
.notify-bar-action {
  font-size: 26rpx;
  color: var(--brand-deep);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(196, 112, 63, 0.14);
}

/* 消息列表 */
.notify-list {
  padding: 0;
}
.notify-item {
  display: flex;
  gap: 14rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  position: relative;
  transition: background 0.15s;
}
.notify-item:last-child {
  border-bottom: none;
}
.notify-unread {
  background: #FDF9F4;
}
.notify-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-top: 12rpx;
  flex-shrink: 0;
}
.notify-body {
  flex: 1;
  min-width: 0;
}
.notify-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
}
.notify-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
  min-width: 0;
}
.notify-type {
  font-size: 20rpx;
  color: var(--ink-3);
  background: #F3EDE6;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.notify-text {
  display: block;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.65;
  margin-top: 8rpx;
}
.notify-time {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
}
