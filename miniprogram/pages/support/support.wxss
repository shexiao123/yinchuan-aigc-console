/* 整页布局：聊天界面需要占满可用高度 */
.support-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F7F2EC;
}

/* 居中态（加载/未登录/空列表） */
.support-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 80rpx 40rpx;
}
.support-center .empty-icon {
  font-size: 80rpx;
  line-height: 1;
}
.support-center .btn {
  margin-top: 16rpx;
}

/* 客服模式：会话列表 */
.conv-list-wrap {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}
.conv-list-head {
  padding: 0 8rpx 20rpx;
}
.conv-list-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}
.conv-list-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}
.conv-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(60, 44, 32, 0.05);
}
.conv-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.conv-item:last-child {
  border-bottom: none;
}
.conv-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8B27A, #C4703F);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.conv-body {
  flex: 1;
  min-width: 0;
}
.conv-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
}
.conv-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.conv-time {
  font-size: 22rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}
.conv-last {
  display: block;
  font-size: 25rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}
.conv-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  padding: 24rpx 24rpx 12rpx;
  box-sizing: border-box;
}

/* 欢迎语 */
.msg-welcome {
  margin-bottom: 28rpx;
  display: flex;
  justify-content: center;
}
.msg-welcome-text {
  font-size: 23rpx;
  color: var(--ink-3);
  background: rgba(255, 255, 255, 0.7);
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 1.6;
  max-width: 520rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 26rpx;
}
.msg-row-mine {
  align-items: flex-end;
}
.msg-bubble {
  max-width: 74%;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 44, 32, 0.06);
  box-sizing: border-box;
}
.msg-bubble-mine {
  background: var(--brand);
  color: #fff;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(196, 112, 63, 0.25);
}
.msg-bubble-hint {
  background: rgba(255, 255, 255, 0.6);
  box-shadow: none;
  color: var(--ink-3);
}
.msg-text {
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-all;
}
.msg-time {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
  padding: 0 6rpx;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line);
  box-sizing: border-box;
}
.input-bar-field {
  flex: 1;
  height: 76rpx;
  background: #F5EFE8;
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}
.input-bar-send {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 34rpx;
  border-radius: 38rpx;
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 76rpx;
  text-align: center;
  border: none;
}
.input-bar-send[disabled] {
  opacity: 0.5;
}
