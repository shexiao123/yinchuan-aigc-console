.dp {
  padding: 24rpx 28rpx 180rpx;
}

.dp-tip {
  padding: 24rpx 26rpx;
  background: var(--brand-soft);
  border-color: #C9DEFF;
}

.dp-tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-deep);
}

.dp-tip-body {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.dp-form {
  margin-top: 22rpx;
  padding: 8rpx 26rpx;
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  position: relative;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}

.field-input {
  font-size: 28rpx;
  color: var(--ink);
  min-height: 56rpx;
}

.field-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.6;
}

.field-count {
  position: absolute;
  right: 0;
  bottom: 22rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.field-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: var(--ink);
  min-height: 56rpx;
}

.field-caret {
  font-size: 20rpx;
  color: var(--ink-3);
}

.field-row {
  display: flex;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.field-half + .field-half {
  margin-left: 32rpx;
}

.dp-note {
  margin-top: 26rpx;
  padding: 0 8rpx;
}

.dp-note-line {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.9;
}

.dp-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
}

.dp-merchant { border-color: #E8C9BF; background: #FFFAF7; }
.dp-merchant .dp-tip-title { color: #A33C30; }
.dp-link { margin-top: 16rpx; font-size: 24rpx; font-weight: 600; color: #C08A4E; }
