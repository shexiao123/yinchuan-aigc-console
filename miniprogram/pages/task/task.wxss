@import "../../styles/merchant.wxss";

.tags { display: flex; gap: 12rpx; }
.tag-open, .tag-video {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 600;
}
.tag-open { color: #047857; background: #E6F4F0; }
.tag-video { color: #6D28D9; background: #F2EFFE; }
.title { font-size: 40rpx; font-weight: 800; color: #0F172A; line-height: 1.4; margin: 22rpx 0; }
.budget-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex-wrap: wrap;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #FDF4F8;
  border: 1rpx solid rgba(219, 39, 119, .12);
  margin-bottom: 26rpx;
}
.budget-label { font-size: 23rpx; color: #475569; }
.budget { font-size: 42rpx; font-weight: 800; color: #DB2777; }
.deadline { margin-left: auto; font-size: 22rpx; color: var(--ink-3); }
.video { width: 100%; height: 400rpx; border-radius: 16rpx; margin-top: 16rpx; background: #0F172A; }
.no-video {
  margin-top: 16rpx;
  padding: 50rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
  border: 1rpx dashed var(--line);
  border-radius: 16rpx;
  background: #F7F8FA;
}
.video-cap { font-size: 22rpx; color: var(--ink-3); margin-top: 12rpx; }
.shop-row { display: flex; align-items: center; gap: 20rpx; margin-top: 14rpx; }
.apply-box { margin: 28rpx; }
.applied {
  display: block;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 650;
  color: #047857;
  background: #EBF7F3;
}

/* 任务进度时间线 */
.tl-item { display: flex; gap: 18rpx; padding: 14rpx 0; border-bottom: 1rpx solid #EDF2FA; }
.tl-item:last-child { border-bottom: none; }
.tl-dot { width: 16rpx; height: 16rpx; margin-top: 10rpx; flex-shrink: 0; border-radius: 50%; background: #4F7DF3; }
.tl-body { flex: 1; min-width: 0; }
.tl-text { font-size: 24rpx; color: #233B5D; line-height: 1.6; }
.tl-time { margin-top: 4rpx; font-size: 21rpx; color: #8A9AAE; }

/* 报名管理 */
.app-item { padding: 18rpx 0; border-bottom: 1rpx solid #EDF2FA; }
.app-item:last-child { border-bottom: none; }
.app-head { display: flex; align-items: center; justify-content: space-between; }
.app-name { font-size: 26rpx; font-weight: 700; color: #0F172A; }
.app-state { font-size: 21rpx; color: #8A9AAE; }
.app-state.on { color: #047857; font-weight: 700; }
.app-msg { margin-top: 8rpx; font-size: 23rpx; line-height: 1.6; color: #66799A; }
.btn-mini { margin-top: 12rpx; background: #EEF4FF; color: #2B4BC4; font-size: 22rpx; }

/* 成片上传 */
.video-pick {
  margin-top: 16rpx;
  padding: 28rpx;
  text-align: center;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(79, 125, 243, .45);
  background: #F3FAFE;
  font-size: 25rpx;
  color: #0284C7;
}
.video-clear { margin-top: 12rpx; font-size: 22rpx; color: #C0574A; text-align: right; }
.btn-soft.danger { background: #FFF1EE; color: #B4473A; border: 1rpx solid #F3D3CC; }
