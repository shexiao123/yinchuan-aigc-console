@import "../../styles/merchant.wxss";

.tags { display: flex; gap: 12rpx; }
.tag-open, .tag-video {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 600;
}
.tag-open { color: #047857; background: #E6F4F0; }
.tag-video { color: #6D28D9; background: #F2EFFE; }
.title { font-size: 40rpx; font-weight: 800; color: #0F172A; line-height: 1.4; margin: 22rpx 0; }
.budget-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex-wrap: wrap;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #FDF4F8;
  border: 1rpx solid rgba(219, 39, 119, .12);
  margin-bottom: 26rpx;
}
.budget-label { font-size: 23rpx; color: #475569; }
.budget { font-size: 42rpx; font-weight: 800; color: #DB2777; }
.deadline { margin-left: auto; font-size: 22rpx; color: var(--ink-3); }
.video { width: 100%; height: 400rpx; border-radius: 16rpx; margin-top: 16rpx; background: #0F172A; }
.no-video {
  margin-top: 16rpx;
  padding: 50rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
  border: 1rpx dashed var(--line);
  border-radius: 16rpx;
  background: #F7F8FA;
}
.video-cap { font-size: 22rpx; color: var(--ink-3); margin-top: 12rpx; }
.shop-row { display: flex; align-items: center; gap: 20rpx; margin-top: 14rpx; }
.apply-box { margin: 28rpx; }
.applied {
  display: block;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 650;
  color: #047857;
  background: #EBF7F3;
}
