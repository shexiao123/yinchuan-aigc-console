<view class="page" wx:if="{{task}}">
  <view class="card">
    <view class="tags">
      <text class="tag-open">{{task.statusText}}</text>
      <text class="tag-video" wx:if="{{task.hasVideo}}">▶ 含参考视频</text>
      <text class="tag-video" wx:if="{{isLocal}}">本机演示任务</text>
    </view>
    <view class="title">{{task.title}}</view>
    <view class="budget-row">
      <text class="budget-label">任务预算</text>
      <text class="budget">{{task.budgetText}}</text>
      <text class="deadline">{{task.deadline || '长期有效'}}</text>
    </view>
    <view class="card-title">项目需求 <text class="card-title-tip" wx:if="{{task.reqCatName}}">{{task.reqCatName}}</text></view>
    <view class="req-rows" wx:if="{{task.hasReqRows}}">
      <view class="req-row" wx:for="{{task.reqRows}}" wx:key="label">
        <text class="req-k">{{item.label}}</text>
        <text class="req-v">{{item.value}}</text>
      </view>
    </view>
    <view class="card-text" wx:else>{{task.description || task.requirement || '商家暂未填写详细说明。'}}</view>
  </view>

  <view class="card">
    <view class="card-title">参考视频</view>
    <video wx:if="{{task.videoUrl}}" class="video" src="{{task.videoUrl}}" controls object-fit="contain" show-fullscreen-btn="{{true}}"></video>
    <view wx:else class="no-video">本任务未提供参考视频，请以文字需求为准</view>
    <view class="video-cap" wx:if="{{task.videoUrl}}">{{task.reference_video_name || task.referenceVideoName || '商家提供的风格参考'}}</view>
  </view>

  <view class="card" wx:if="{{task.deliveryUrl}}">
    <view class="card-title">已交付成片</view>
    <video class="video" src="{{task.deliveryUrl}}" controls object-fit="contain" show-fullscreen-btn="{{true}}"></video>
    <view class="video-cap">{{task.deliveryVideoName || '成片.mp4'}}{{task.deliveryNote ? ' · ' + task.deliveryNote : ''}}</view>
  </view>

  <view class="card">
    <view class="card-title">发布商家</view>
    <view class="shop-row" bindtap="onShop">
      <view class="shop-logo small">{{task.merchantInitial}}</view>
      <view>
        <view class="shop-name">{{task.merchant ? task.merchant.name : task.merchantName}}</view>
        <view class="shop-meta">{{task.merchantCity}} · {{isLocal ? '本机店铺' : '点击查看店铺 ›'}}</view>
      </view>
    </view>
  </view>

  <!-- 项目履约：保证金 / 截止日期 / 违约金 / 返还账户 -->
  <view class="card" wx:if="{{guarantee}}">
    <view class="card-title">项目履约 <text class="card-title-tip">演示记账</text></view>
    <view class="req-rows">
      <view class="req-row"><text class="req-k">交付截止</text><text class="req-v">{{guarantee.dueText}} · {{guarantee.remainText}}</text></view>
      <view class="req-row"><text class="req-k">发布方保证金</text><text class="req-v">¥{{guarantee.publisherDepositText}} · {{guarantee.publisherStateText}}</text></view>
      <view class="req-row"><text class="req-k">接单方保证金</text><text class="req-v">¥{{guarantee.providerDepositText}}（15%）· {{guarantee.providerStateText}}</text></view>
      <view class="req-row" wx:if="{{guarantee.hasPenalty}}"><text class="req-k">违约金</text><text class="req-v">¥{{guarantee.penaltyText}}（平台 ¥{{guarantee.penaltyPlatformText}} / 发布者 ¥{{guarantee.penaltyPublisherText}}）</text></view>
      <view class="req-row"><text class="req-k">返还账户</text><text class="req-v">{{guarantee.channelText}}</text></view>
    </view>
    <view class="card-text" wx:if="{{guarantee.hasReview}}">已有 {{guarantee.reviewList.length}} 条审核记录，修改意见与新提交日期见交付通道。</view>
    <button class="btn-ghost" bindtap="onDeliveryChannel">项目交付通道（上传 / 审核）›</button>
  </view>

  <!-- 任务进度时间线 -->
  <view class="card" wx:if="{{task.timelineText.length}}">
    <view class="card-title">任务进度</view>
    <view class="tl-item" wx:for="{{task.timelineText}}" wx:key="index">
      <view class="tl-dot"></view>
      <view class="tl-body">
        <view class="tl-text">{{item.text}}</view>
        <view class="tl-time">{{item.timeText}}</view>
      </view>
    </view>
  </view>

  <!-- 商家侧：报名管理 + 验收 -->
  <block wx:if="{{isLocal && isOwner}}">
    <view class="card">
      <view class="card-title">报名管理（{{task.applicantCount}} 人）</view>
      <view class="app-item" wx:for="{{task.applications}}" wx:key="id">
        <view class="app-head">
          <text class="app-name">{{item.applicantName}}</text>
          <text class="app-state {{item.status === 'selected' ? 'on' : ''}}">{{item.status === 'selected' ? '已选定' : item.status === 'rejected' ? '未入选' : '待查看'}}</text>
        </view>
        <view class="app-msg">{{item.message || '未填写补充说明'}}</view>
        <button wx:if="{{task.status === 'open' && item.status === 'pending'}}" class="btn-mini" size="mini" data-id="{{item.id}}" data-name="{{item.applicantName}}" bindtap="onSelectApplicant">选定承接</button>
      </view>
      <view class="empty" wx:if="{{!task.applications.length}}">还没有人报名，可先到任务广场查看</view>
    </view>

    <view class="card" wx:if="{{task.status === 'delivered'}}">
      <view class="card-title">发布者审核</view>
      <view class="card-text">审核通过无需填写意见，通过后双方保证金自动返还原支付账户；不通过必须填写修改意见和新的提交日期。</view>
      <button class="btn-primary" bindtap="onAccept" disabled="{{submitting}}">审核通过，完成任务并返还保证金</button>
      <button class="btn-soft" bindtap="onReject" disabled="{{submitting}}">审核不通过（填意见 + 新日期）</button>
    </view>

    <view class="card" wx:if="{{task.status === 'open' || task.status === 'taken'}}">
      <view class="card-title">任务管理</view>
      <view class="card-text">{{task.status === 'open' ? '选定承接方后任务进入制作中。' : '当前制作中，等待承接方上传成片。'}}</view>
      <button class="btn-soft danger" bindtap="onCancelTask" disabled="{{submitting}}">关闭任务</button>
    </view>
  </block>

  <!-- 承接方侧：报名 / 交付 -->
  <block wx:if="{{isLocal && !isOwner}}">
    <view class="apply-box" wx:if="{{applied}}">
      <text class="applied">✓ 你已报名（{{applied.status === 'selected' ? '商家已选定你，请交付成片' : applied.status === 'rejected' ? '本次未入选' : '等待商家查看'}}）</text>
    </view>

    <view class="card" wx:if="{{canDeliver && task.status === 'taken'}}">
      <view class="card-title">交付成片</view>
      <view class="card-text">选择本机视频作为成片，提交后商家可在线播放并验收。</view>
      <view class="video-pick" bindtap="onChooseDelivery">
        <text wx:if="{{deliveryName}}">▶ {{deliveryName}}</text>
        <text wx:else>＋ 选择成片视频（≤100MB）</text>
      </view>
      <view class="video-clear" wx:if="{{deliveryName}}" bindtap="clearDelivery">移除已选视频</view>
      <button class="btn-primary" bindtap="onDeliver" disabled="{{submitting}}">提交成片</button>
    </view>

    <view class="apply-box" wx:if="{{canDeliver && task.status === 'delivered'}}">
      <text class="applied">✓ 成片已交付，等待商家验收</text>
    </view>
    <button wx:if="{{!applied && task.status === 'open'}}" class="btn-primary" bindtap="onApply">我要接单</button>
    <button wx:elif="{{task.status !== 'open' && !canDeliver}}" class="btn-disabled" disabled>任务已停止招募</button>
  </block>

  <!-- 云端任务：保留原报名流程 -->
  <block wx:if="{{!isLocal}}">
    <view class="apply-box" wx:if="{{applied}}">
      <text class="applied">✓ 你已报名（{{applied.status === 'selected' ? '商家已选定你' : applied.status === 'rejected' ? '本次未入选' : '等待商家查看'}}）</text>
    </view>
    <button wx:elif="{{task.status === 'open'}}" class="btn-primary" bindtap="onApply">我要接单</button>
    <button wx:else class="btn-disabled" disabled>任务已结束</button>
  </block>

  <button class="btn-ghost" wx:if="{{!guarantee}}" bindtap="onDeliveryChannel">项目交付通道（上传 / 审核）›</button>
  <button class="btn-ghost" bindtap="onAllTasks">看看其他任务</button>
</view>

<view class="page" wx:elif="{{!loading}}">
  <view class="empty">任务不存在或已下架</view>
</view>
