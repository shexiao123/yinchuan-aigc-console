.group-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F9FD;
  box-sizing: border-box;
}

.group-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.group-loading-text { font-size: 26rpx; color: #7A8BA0; }
.group-empty-icon { font-size: 80rpx; }

.group-head {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 22rpx 24rpx;
  background: #fff; border-bottom: 1rpx solid #E7EEF6;
}
.group-head-left { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.group-head-name { font-size: 30rpx; font-weight: 700; color: #0B1F33; }
.group-head-sub { font-size: 22rpx; color: #61738A; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.group-live {
  display: flex; align-items: center; gap: 8rpx; flex: 0 0 auto;
  font-size: 21rpx; font-weight: 700; color: #0E8F7E;
  background: rgba(34,184,166,.10); border-radius: 24rpx; padding: 8rpx 16rpx;
}
.group-live-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #22B8A6; }

.msg-list { flex: 1; overflow-y: auto; padding: 24rpx; box-sizing: border-box; }
.msg-tip { text-align: center; margin: 8rpx 0 26rpx; }
.msg-tip text {
  font-size: 22rpx; color: #7A8BA0; line-height: 1.6;
  background: rgba(255,255,255,.9); border: 1rpx solid #E7EEF6;
  border-radius: 12rpx; padding: 12rpx 20rpx;
}
.msg-bottom { height: 12rpx; }

.msg-row { display: flex; align-items: flex-start; gap: 14rpx; margin-bottom: 26rpx; }
.msg-row-mine { flex-direction: row-reverse; }
.msg-avatar {
  width: 60rpx; height: 60rpx; flex: 0 0 60rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 18rpx; font-size: 26rpx; font-weight: 700; color: #fff;
  background: linear-gradient(135deg, #0EA5E9, #7C5CF0);
}
.msg-body { display: flex; flex-direction: column; max-width: 72%; }
.msg-row-mine .msg-body { align-items: flex-end; }
.msg-sender { font-size: 21rpx; color: #7A8BA0; margin-bottom: 6rpx; }
.msg-bubble {
  background: #fff; border: 1rpx solid #E7EEF6;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  padding: 18rpx 22rpx;
  box-shadow: 0 8rpx 20rpx -16rpx rgba(20,60,120,.6);
}
.msg-bubble-mine {
  background: #4F7DF3; border-color: #4F7DF3;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
}
.msg-text { font-size: 27rpx; line-height: 1.6; color: #33465C; word-break: break-all; }
.msg-bubble-mine .msg-text { color: #fff; }
.msg-hidden { opacity: .5; }
.msg-hidden .msg-text { text-decoration: line-through; }
.msg-time { font-size: 20rpx; color: #9AA9BB; margin-top: 8rpx; }
.msg-sys {
  width: 100%; text-align: center;
  font-size: 22rpx; line-height: 1.7; color: #7A8BA0;
  background: rgba(255,255,255,.85); border: 1rpx solid #E7EEF6;
  border-radius: 12rpx; padding: 14rpx 20rpx; box-sizing: border-box;
}

.input-bar {
  display: flex; align-items: center; gap: 14rpx;
  padding: 16rpx 20rpx; background: #fff;
  border-top: 1rpx solid #E7EEF6;
}
.input-bar-login { justify-content: space-between; font-size: 24rpx; color: #61738A; }
.input-bar-field {
  flex: 1; min-width: 0;
  background: #F4F8FC; border: 1rpx solid #E3EBF4; border-radius: 36rpx;
  padding: 16rpx 24rpx; font-size: 26rpx; color: #0B1F33;
}
.input-placeholder { color: #A6B4C4; }
.input-bar-send {
  margin: 0; padding: 0 30rpx; height: 68rpx; line-height: 68rpx;
  font-size: 26rpx; color: #fff; background: #4F7DF3; border-radius: 34rpx;
}
.input-bar-send[disabled] { opacity: .5; }
.group-foot-tip { text-align: center; font-size: 20rpx; color: #9AA9BB; padding: 10rpx 0 16rpx; background: #fff; }
