.apply-banner {
  margin: 20rpx 28rpx 0;
  background: linear-gradient(135deg, #FBF3EA, #F7EFE4);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
}

.apply-banner-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-deep);
  margin-bottom: 8rpx;
}

.apply-banner-text {
  display: block;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.block-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.field-row {
  display: flex;
}

.field-half {
  flex: 1;
}

.field-half:first-child {
  margin-right: 20rpx;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FAF6F1;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
}

.picker-text {
  font-size: 28rpx;
  color: var(--ink);
}

.picker-arrow {
  font-size: 32rpx;
  color: #CFC4BA;
}

.form-error {
  margin: 24rpx 28rpx 0;
  background: #FBEDEA;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.form-error-text {
  font-size: 24rpx;
  color: #A8463A;
  line-height: 1.6;
}

.submit-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 20rpx;
}

/* ---------------- 服务封面 ---------------- */
.cover-picker {
  position: relative;
  width: 100%;
  height: 200rpx;
  border: 1rpx dashed var(--line);
  border-radius: 16rpx;
  overflow: hidden;
  background: #F7F2EC;
}

.cover-picker-img {
  width: 100%;
  height: 100%;
}

.cover-picker-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.cover-picker-icon {
  font-size: 44rpx;
  opacity: .55;
}

.cover-picker-text {
  font-size: 25rpx;
  color: var(--ink-2);
}

.cover-picker-hint {
  font-size: 20rpx;
  color: var(--ink-3);
}

.cover-picker-loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 30, 24, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-picker-loading-text {
  color: #fff;
  font-size: 24rpx;
}

.cover-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

/* ---------------- 专业方向 / 城市预设 ---------------- */
.role-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.role-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #F7F2EC;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
}

.role-chip-icon {
  font-size: 24rpx;
}

.role-chip-text {
  font-size: 25rpx;
  color: var(--ink-2);
}

.role-chip-on {
  background: var(--brand-soft);
  border-color: rgba(180, 120, 60, 0.42);
}

.role-chip-on .role-chip-text {
  color: var(--brand-deep);
  font-weight: 600;
}

.role-preset-row {
  margin-top: 12rpx;
}

.role-preset-label {
  display: block;
  font-size: 21rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

.role-preset-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.role-preset {
  font-size: 22rpx;
  color: var(--ink-2);
  background: #F5EFE8;
  border-radius: 999rpx;
  padding: 7rpx 20rpx;
}

.role-preset-on {
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 600;
}

.field-hint {
  display: block;
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
  line-height: 1.5;
}
