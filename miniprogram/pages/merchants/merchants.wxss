@import "../../styles/merchant.wxss";

.mc-hero {
  margin: 28rpx;
  padding: 40rpx 34rpx;
  border-radius: 28rpx;
  background: linear-gradient(120deg, #EAF3FE 0%, #F0EEFD 55%, #F8F4FF 100%);
  border: 1rpx solid rgba(79, 125, 243, .16);
}
.mc-hero-eyebrow {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: #4F46E5;
  background: rgba(124, 92, 240, .10);
}
.mc-hero-title { display: block; font-size: 42rpx; font-weight: 800; color: #0F172A; margin: 22rpx 0 12rpx; line-height: 1.35; }
.mc-hero-sub { display: block; font-size: 25rpx; color: #475569; line-height: 1.7; }
.mc-hero-btn {
  display: inline-block;
  margin-top: 26rpx;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(120deg, #0EA5E9, #4F7DF3 58%, #7C5CF0);
}
.tabs { display: flex; gap: 16rpx; padding: 8rpx 28rpx 24rpx; }
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 650;
  color: #475569;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}
.tab text { font-size: 22rpx; color: #94A3B8; margin-left: 6rpx; }
.tab.active { color: #FFFFFF; background: linear-gradient(120deg, #0EA5E9, #4F7DF3 58%, #7C5CF0); border-color: transparent; }
.tab.active text { color: rgba(255,255,255,.85); }

.shop-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 22rpx;
  box-shadow: 0 2rpx 16rpx rgba(15, 23, 42, .05);
}
.shop-body { flex: 1; min-width: 0; }
.shop-intro { font-size: 23rpx; color: var(--ink-2); line-height: 1.6; margin-top: 8rpx; }
.arrow { font-size: 40rpx; color: #94A3B8; }
