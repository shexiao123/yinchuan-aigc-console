<view class="page">
  <!-- 搜索 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索服务，如「婚礼微电影」"
        placeholder-class="input-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
    </view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="cat-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="cat-row">
      <view class="cat-chip {{activeCat === '' ? 'cat-chip-active' : ''}}" bindtap="onCatTap" data-slug="">
        <text>全部</text>
      </view>
      <view
        class="cat-chip {{activeCat === item.slug ? 'cat-chip-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="onCatTap"
        data-slug="{{item.slug}}"
      >
        <text>{{item.icon}} {{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="container">
    <view class="result-bar" wx:if="{{!loading}}">
      <text class="result-count">共 {{total}} 项服务</text>
    </view>

    <view class="svc-list" wx:if="{{!loading && services.length}}">
      <view class="svc-item card" wx:for="{{services}}" wx:key="id" bindtap="onServiceTap" data-id="{{item.id}}">
        <view class="svc-cover {{item.coverClass}}">
          <image class="svc-cover-img" src="{{item.coverUrl}}" mode="aspectFill"
                 data-field="services" data-idx="{{index}}" data-key="coverUrl"
                 data-fallback="{{item.localCover}}" binderror="onImageFallback" />
        </view>
        <view class="svc-body">
          <text class="svc-title ellipsis">{{item.title}}</text>
          <text class="svc-sub ellipsis">{{item.subtitle}}</text>
          <view class="svc-meta">
            <text class="svc-meta-item">★ {{item.rating}}</text>
            <text class="svc-meta-dot">·</text>
            <text class="svc-meta-item">已售 {{item.sales_count}}</text>
            <text class="svc-meta-dot">·</text>
            <text class="svc-meta-item">{{item.delivery_days}} 天交付</text>
          </view>
          <view class="svc-foot">
            <view class="svc-price">
              <text class="price"><text class="price-symbol">¥</text><text class="price-value">{{item.priceText}}</text></text>
              <text class="price-old" wx:if="{{item.oldPriceText}}">¥{{item.oldPriceText}}</text>
              <text class="price-unit">/{{item.unit}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 漫剧制作：整案对接，不划分标品服务项 -->
    <view class="int-panel" wx:if="{{!loading && !services.length && isComic}}">
      <text class="int-badge">🎭 漫剧制作 · 整案对接</text>
      <text class="int-title">不拆服务项，按项目整体定制</text>
      <text class="int-desc">从选题策划、分集剧本、分镜与角色锚点，到 AI 生成、配音与竖屏成片，由一个团队按项目整体承接。平台不设单独服务项与固定报价，需求沟通后按项目出方案、走平台担保交易。</text>
      <view class="int-flow">
        <text>① 说清题材与集数</text>
        <text>② 上传参考视频</text>
        <text>③ 团队整案报价</text>
        <text>④ 平台担保交付</text>
      </view>
      <view class="int-actions">
        <view class="int-btn int-btn-main" bindtap="onComicTasks">查看在招漫剧项目 ›</view>
        <view class="int-btn" bindtap="onComicGroups">去群聊沟通</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && !services.length && !isComic}}">
      <text class="empty-icon">🎬</text>
      <text class="empty-text">没有找到匹配的服务</text>
      <text class="empty-hint">换个关键词或分类试试</text>
    </view>

    <view class="loading-box" wx:if="{{loading}}">正在加载…</view>
  </view>
</view>
