{
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "guangying-orders",
  "description": "宁夏云辇文化科技有限公司 - 影视制作接单平台",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "newFeature": true,
    "nodeModules": false,
    "packNpmManually": true,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./package.json",
        "miniprogramNpmDistDir": "./miniprogram_npm"
      }
    ],
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "useCompilerPlugins": false,
    "ignoreUploadUnusedFiles": true
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "file",
        "value": "package-lock.json"
      },
      {
        "type": "file",
        "value": ".gitignore"
      },
      {
        "type": "suffix",
        "value": ".privacy.json"
      }
    ],
    "include": []
  },
  "condition": {
    "miniprogram": {
      "list": [
        {
          "name": "首页",
          "pathName": "pages/index/index",
          "query": "",
          "scene": null
        },
        {
          "name": "接单工作台",
          "pathName": "pages/studio/studio",
          "query": "",
          "scene": null
        },
        {
          "name": "平台后台",
          "pathName": "pages/admin/admin",
          "query": "",
          "scene": null
        }
      ]
    }
  }
}
